/**
* Name: ReproducibilityTest
* Description: Checks that every random operator draws the same values when the seed is the same, and different
* 	values when it is not, for each of the deterministic random number generators
* Tags: property, random, seed, reproducibility, test
*/

model ReproducibilityTestModel

global {
	geometry shape <- square(100);
}

species walker {
}

experiment ReproducibilityTest type: test autorun: true {

	/** Draws one value with each random operator */
	list draw_all() {
		return [rnd(1000), rnd(1.0), rnd(5, 10), rnd(0.0, 1.0, 0.1), flip(0.5), gauss(0, 1), gauss({0, 1}),
			truncated_gauss(0, 1, -1, 1), poisson(3.0), binomial(10, 0.5), exp_rnd(2.0), gamma_rnd(2.0, 2.0),
			lognormal_rnd(0.0, 1.0), weibull_rnd(1.0, 1.5), skew_gauss(0.0, 1.0, 0.7, 0.2), rnd_choice([0.2, 0.3, 0.5]),
			shuffle([1, 2, 3, 4, 5, 6]), 3 among [1, 2, 3, 4, 5, 6], one_of([1, 2, 3, 4, 5, 6]), any([1, 2, 3, 4, 5, 6]),
			rnd_color(255), any_location_in(square(10)), sample([1, 2, 3, 4, 5], 3, false), rnd({10, 10, 10})];
	}

	list draw_sequence(float s) {
		seed <- s;
		list result <- [];
		loop times: 5 {
			result <+ draw_all();
		}
		return result;
	}

	test "The same seed gives the same draws" {
		list first_draw <- draw_sequence(42.0);
		list second_draw <- draw_sequence(42.0);
		list<string> different <- [];
		loop i from: 0 to: length(first_draw) - 1 {
			if (first_draw[i] != second_draw[i]) { different <+ string(first_draw[i]) + " / " + second_draw[i]; }
		}
		// the inputs that break the invariant are listed in the error
		if (!empty(different)) { error "draws differ with the same seed: " + different; }
		assert empty(different);
	}

	test "Different seeds give different draws" {
		list first_draw <- draw_sequence(42.0);
		list second_draw <- draw_sequence(43.0);
		assert first_draw != second_draw;
		// almost every continuous value must differ
		list<float> first_floats <- (first_draw collect list(each)[1]);
		list<float> second_floats <- (second_draw collect list(each)[1]);
		assert first_floats != second_floats;
	}

	test "Each deterministic generator is reproducible" {
		list<string> failures <- [];
		string initial <- simulation.rng;
		loop generator over: ["mersenne", "parallel", "java"] {
			ask simulation { rng <- generator; }
			list first_draw <- draw_sequence(7.0);
			list second_draw <- draw_sequence(7.0);
			if (first_draw != second_draw) { failures <+ generator; }
		}
		ask simulation { rng <- initial; }
		// the inputs that break the invariant are listed in the error
		if (!empty(failures)) { error "generators that are not reproducible: " + failures; }
		assert empty(failures);
	}

	test "Creating agents at random locations is reproducible" {
		seed <- 11.0;
		create walker number: 10 returns: first_agents;
		list<point> first_locations <- first_agents collect each.location;
		seed <- 11.0;
		create walker number: 10 returns: second_agents;
		list<point> second_locations <- second_agents collect each.location;
		assert first_locations = second_locations;
		ask first_agents + second_agents { do die; }
	}

	test "The draws are not altered by an unrelated computation" {
		list first_draw <- draw_sequence(5.0);
		seed <- 5.0;
		float unrelated <- sqrt(2) * #pi;
		list second_draw <- [];
		loop times: 5 { second_draw <+ draw_all(); }
		assert first_draw = second_draw;
	}
}
