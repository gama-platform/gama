/**
* Name: CastingTest
* Author: Antigravity
* Description: Tests the type casting operations across GAMA data types
* Tags: casting, typing, test
*/

experiment CastingTest type: test autorun: true {
	
	test "String to Numeric Conversions" {
		assert int("42") = 42;
		assert float("3.14") = 3.14;
		
		// Strings with whitespace
		assert int(" 42 ") = 42;
		assert float(" 3.14 ") = 3.14;
	}
	
	test "Numeric to Numeric Conversions" {
		assert int(3.14) = 3;
		assert int(3.99) = 3;
		assert float(42) = 42.0;
	}
	
	test "Numeric to String Conversions" {
		assert string(42) = "42";
		assert string(3.14) = "3.14";
	}
	
	test "Collections Casting" {
		// '[key::value, ...]' is a map literal, not a list of pairs
		map<string, int> src <- ["a"::1, "b"::2];
		assert src["a"] = 1;
		assert src["b"] = 2;

		// Casting a map to a list yields its values
		list l1 <- list(src);
		assert length(l1) = 2;
		assert l1 contains 1 = true;
		assert l1 contains 2 = true;

		// A list of pairs casts back to the equivalent map
		list<pair<string, int>> lp <- src.pairs;
		assert length(lp) = 2;
		map<string, int> m1 <- map(lp);
		assert m1["a"] = 1;
		assert m1["b"] = 2;

		// Nested lists build a matrix, one inner list per column
		matrix<int> mat <- matrix([[1, 2], [3, 4]]);
		assert mat[0, 0] = 1;
		assert mat[0, 1] = 2;
		assert mat[1, 0] = 3;
		assert mat[1, 1] = 4;

		// 'matrix_with' fills every cell with the right operand, it does not spread a list
		matrix<int> ones <- {2, 2} matrix_with (1);
		assert ones[0, 0] = 1;
		assert ones[1, 1] = 1;
	}
	
	test "Boolean Casting" {
		assert bool("true") = true;
		assert bool("false") = false;
		
		assert string(true) = "true";
		assert string(false) = "false";
		
		assert int(true) = 1;
		assert int(false) = 0;
	}
}
