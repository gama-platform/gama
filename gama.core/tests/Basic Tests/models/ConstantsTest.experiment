/**
* Name: ConstantsTest
* Description: Tests the numeric constants (#nan, #infinity, #max_float, #min_float, #max_int, #min_int)
* 	and the mathematical ones (#pi, #e, #to_deg, #to_rad), with a focus on their edge-case behaviour
* Tags: constant, float, int, math, test
*/

experiment ConstantsTest type: test autorun: true {

	test "Mathematical constants" {
		assert #pi = 3.141592653589793;
		assert #e = 2.718281828459045;
		assert ln(#e) = 1.0;
		assert exp(1.0) = #e;

		// #to_deg and #to_rad are the inverse of each other
		assert #to_deg = 180 / #pi;
		assert #to_rad = #pi / 180;
		assert #to_deg * #to_rad = 1.0;
		assert #pi * #to_deg = 180.0;
		assert 180 * #to_rad = #pi;

		// trigonometric operators work in degrees, the '_rad' variants in radians
		assert cos(#pi * #to_deg) = -1.0;
		assert cos_rad(#pi) = -1.0;
	}

	test "Integer bounds" {
		assert #max_int = 2147483647;
		assert #min_int = -2147483647 - 1;
		assert #max_int is int;
		assert #min_int is int;
		assert #min_int < 0;
		assert #max_int > 0;
		assert is_number(#max_int);
		assert is_number(#min_int);
		assert is_finite(#max_int);

		// they are the bounds of any other int
		assert max([#max_int, 0, #min_int]) = #max_int;
		assert min([#max_int, 0, #min_int]) = #min_int;
	}

	test "Integer overflow wraps around" {
		assert #max_int + 1 = #min_int;
		assert #min_int - 1 = #max_int;
		assert #max_int * 2 = -2;
		// the opposite of #min_int does not fit in an int
		assert -#min_int = #min_int;
		assert abs(#min_int) = #min_int;

		// moving to floats avoids the overflow
		assert float(#max_int) + 1 = 2147483648.0;
		assert float(#max_int) + 1 > #max_int;
	}

	test "Float bounds" {
		assert #max_float = 1.7976931348623157E308;
		assert #min_float = 4.9E-324;
		assert #max_float is float;
		assert #min_float is float;
		assert is_number(#max_float);
		assert is_finite(#max_float);
		assert is_finite(-#max_float);
		assert #max_float > #max_int;
		assert -#max_float < #min_int;

		// #min_float is the smallest positive float, not the most negative one
		assert #min_float > 0.0;
		assert #min_float < 1.0;
		// nothing smaller can be represented
		assert #min_float / 2 = 0.0;
	}

	test "Float equality is tolerant" {
		// '=' on floats absorbs rounding errors...
		assert 0.1 + 0.2 = 0.3;
		// ... which also means the smallest float is 'equal' to zero while being greater than it
		assert #min_float = 0.0;
		assert #min_float > 0.0;
		// and that adding 1 to the biggest float goes unnoticed
		assert #max_float + 1 = #max_float;
	}

	test "Float overflow yields infinity" {
		assert not is_finite(#max_float * 2);
		assert #max_float * 2 > #max_float;
		assert not is_finite(-#max_float * 2);
		assert -#max_float * 2 < -#max_float;
		assert not is_finite(exp(1000));
		assert not is_finite(10.0 ^ 400);
		assert not is_finite(1e308 * 10);
	}

	test "Infinity" {
		assert #infinity is float;
		assert #infinity = #infinity;
		assert #infinity != -#infinity;
		assert #infinity != #max_float;
		assert -#infinity = -#infinity;

		// infinity is a number, but not a finite one
		assert is_number(#infinity);
		assert is_number(-#infinity);
		assert not is_finite(#infinity);
		assert not is_finite(-#infinity);

		// it bounds every other number
		assert #infinity > #max_float;
		assert #infinity > #max_int;
		assert -#infinity < -#max_float;
		assert -#infinity < #min_int;
		assert max([#infinity, #max_float]) = #infinity;
		assert min([-#infinity, #min_int]) = -#infinity;

		assert abs(-#infinity) = #infinity;
		assert signum(#infinity) = 1;
		assert signum(-#infinity) = -1;
		assert sqrt(#infinity) = #infinity;
	}

	test "Infinities obtained by computation are equal to #infinity" {
		float positive <- #infinity;
		assert positive + 1 = #infinity;
		assert #max_float * 2 = #infinity;
		assert -#max_float * 2 = -#infinity;
		assert exp(1000) = #infinity;
		assert 10.0 ^ 400 = #infinity;
		assert 1e308 * 10 = #infinity;
		assert -positive = -#infinity;
	}

	test "Infinity arithmetic" {
		// infinity absorbs finite operands
		assert not is_finite(#infinity + 1);
		assert #infinity + 1 > #max_float;
		assert not is_finite(#infinity - #max_float);
		assert not is_finite(#infinity * 2);
		assert #infinity * -1 < -#max_float;
		assert sum([1.0, #infinity]) > #max_float;
		assert 1 / #infinity = 0.0;

		// undetermined forms are not numbers
		assert not is_number(#infinity - #infinity);
		assert not is_number(#infinity * 0);
		assert not is_number(#infinity / #infinity);
		assert not is_number(cos(#infinity));
	}

	test "Infinity casting" {
		assert string(#infinity) = "Infinity";
		assert string(-#infinity) = "-Infinity";
		assert float("Infinity") = #infinity;
		assert float("-Infinity") = -#infinity;
		assert to_gaml(#infinity) = "#infinity";

		// casting to int saturates
		assert int(#infinity) = #max_int;
		assert int(-#infinity) = #min_int;
		assert int(#max_float) = #max_int;
		assert int(-#max_float) = #min_int;
		assert round(#infinity) = #max_int;
		assert floor(#infinity) = #max_int;
		assert ceil(-#infinity) = #min_int;
	}

	test "Not a number" {
		assert #nan is float;
		assert not is_number(#nan);

		// contrary to IEEE 754, #nan is equal to itself in GAML
		assert #nan = #nan;
		assert not (#nan != #nan);
		assert #nan != 0.0;
		assert #nan != #infinity;

		// but it is not ordered with anything
		assert not (#nan < 1.0);
		assert not (#nan > 1.0);
		assert not (#nan <= #nan);
		assert not (#nan >= #nan);
		assert not (#nan < #infinity);
		assert not (#nan > -#infinity);

		// 'is_finite' only rules out the infinities
		assert is_finite(#nan);
		assert signum(#nan) = 0;
	}

	test "Not a number propagates" {
		assert not is_number(#nan + 1);
		assert not is_number(#nan - #nan);
		assert not is_number(#nan * 0);
		assert not is_number(#nan / 2);
		assert not is_number(mean([1.0, #nan, 3.0]));
		assert not is_number(sum([1.0, #nan, 3.0]));

		// a result that is not a number can be compared to #nan
		assert #infinity - #infinity = #nan;
		assert asin(10) = #nan;
		assert acos(-10) = #nan;
	}

	test "Not a number casting" {
		assert string(#nan) = "NaN";
		assert float("NaN") = #nan;
		assert to_gaml(#nan) = "#nan";
		assert not is_number("NaN");
		assert int(#nan) = 0;
		assert round(#nan) = 0;
	}

	test "Not a number in containers" {
		list<float> l <- [3.0, #nan, 1.0];
		assert l contains #nan;
		assert l index_of #nan = 1;
		assert l count (not is_number(each)) = 1;
		assert (l where is_number(each)) = [3.0, 1.0];

		// min and max ignore it
		assert min(l) = 1.0;
		assert max(l) = 3.0;

		// sorting pushes it after the infinity
		list<float> sorted <- [3.0, #nan, 1.0, #infinity, -#infinity] sort_by each;
		assert sorted[0] = -#infinity;
		assert sorted[1] = 1.0;
		assert sorted[2] = 3.0;
		assert sorted[3] = #infinity;
		assert not is_number(sorted[4]);

		map<string, float> m <- ["a"::#nan, "b"::#infinity];
		assert m["a"] = #nan;
		assert m["b"] = #infinity;
	}

	test "Undefined operations raise an error rather than returning a constant" {
		// by design, dividing by zero is an error and does not yield #infinity or #nan
		bool float_division_failed <- false;
		try { float f <- 1.0 / 0.0; } catch { float_division_failed <- true; }
		assert float_division_failed;

		bool zero_by_zero_failed <- false;
		try { float f <- 0.0 / 0.0; } catch { zero_by_zero_failed <- true; }
		assert zero_by_zero_failed;

		bool int_division_failed <- false;
		try { float f <- 1 / 0; } catch { int_division_failed <- true; }
		assert int_division_failed;

		bool div_failed <- false;
		try { int i <- 5 div 0; } catch { div_failed <- true; }
		assert div_failed;

		bool mod_failed <- false;
		try { int i <- 5 mod 0; } catch { mod_failed <- true; }
		assert mod_failed;

		bool sqrt_failed <- false;
		try { float f <- sqrt(-1); } catch { sqrt_failed <- true; }
		assert sqrt_failed;

		bool ln_failed <- false;
		try { float f <- ln(0); } catch { ln_failed <- true; }
		assert ln_failed;
	}
}
