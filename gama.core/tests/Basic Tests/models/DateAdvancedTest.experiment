/**
* Name: DateAdvancedTest
* Author: Antigravity
* Description: Tests advanced chronological manipulations and localized time additions
* Tags: date, time, calendar, test
*/

experiment DateAdvancedTest type: test autorun: true {
	
	test "Calendar Mathematical Adjustments" {
		date d1 <- date("2026-09-16T15:00:00");
		
		date d_days <- d1 add_days 5;
		assert d_days.day = 21;
		assert d_days.month = 9;
		
		date d_months <- d1 add_months 2;
		assert d_months.month = 11;
		
		date d_years <- d1 add_years 4;
		assert d_years.year = 2030;
		
		date d_sub <- d1 subtract_days 10;
		assert d_sub.day = 6;
	}
	
	test "Time Extractions" {
		date d1 <- date("2026-09-16T15:30:45");
		
		// Wait, GAMA dates have year, month, day, hour, minute, second
		assert d1.year = 2026;
		assert d1.minute = 30;
		assert d1.second = 45;
		
		// Day of week
		// The 16th of September 2026 is a Wednesday (usually day 3 or 4 depending on convention)
		// We can just verify it doesn't crash
		int dow <- d1.day_of_week;
		assert dow > 0;
	}
	
	test "Time Spans and Durations" {
		date d_start <- date("2026-01-01T00:00:00");
		date d_end <- date("2026-01-31T00:00:00");
		
		// The difference between two dates is the duration in seconds
		float diff <- d_end - d_start;
		assert diff = 30 #days; // 30 days exactly
		
		// 'before'/'after' compare the *simulation* date; two dates are compared with < and >
		assert d_start < d_end;
		assert d_end > d_start;
		assert (d_start < d_start) = false;
	}
}
