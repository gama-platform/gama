/**
* Name: DateArithmeticTest
* Description: Tests the operators that shift dates (plus_*, minus_*, add_*, subtract_*), the ones that measure
* 	the time between two dates (*_between), the calendar attributes of a date and its formatting
* Tags: date, time, test
*/

experiment DateArithmeticTest type: test autorun: true {

	date reference <- date("2026-03-15T10:30:45");

	test "Adding to a date" {
		assert reference plus_seconds 30 = date("2026-03-15T10:31:15");
		assert reference plus_minutes 45 = date("2026-03-15T11:15:45");
		assert reference plus_hours 15 = date("2026-03-16T01:30:45");
		assert reference plus_days 20 = date("2026-04-04T10:30:45");
		assert reference plus_weeks 2 = date("2026-03-29T10:30:45");
		assert reference plus_months 11 = date("2027-02-15T10:30:45");
		assert reference plus_years 2 = date("2028-03-15T10:30:45");
		assert reference plus_ms 2000 = date("2026-03-15T10:30:47");
	}

	test "Subtracting from a date" {
		assert reference minus_seconds 46 = date("2026-03-15T10:29:59");
		assert reference minus_minutes 31 = date("2026-03-15T09:59:45");
		assert reference minus_hours 11 = date("2026-03-14T23:30:45");
		assert reference minus_days 20 = date("2026-02-23T10:30:45");
		assert reference minus_weeks 2 = date("2026-03-01T10:30:45");
		assert reference minus_months 3 = date("2025-12-15T10:30:45");
		assert reference minus_years 2 = date("2024-03-15T10:30:45");
		assert reference minus_ms 1000 = date("2026-03-15T10:30:44");
	}

	test "add_ and subtract_ are synonyms of plus_ and minus_" {
		assert reference add_seconds 15 = reference plus_seconds 15;
		assert reference add_minutes 30 = reference plus_minutes 30;
		assert reference add_hours 2 = reference plus_hours 2;
		assert reference add_days 5 = reference plus_days 5;
		assert reference add_weeks 1 = reference plus_weeks 1;
		assert reference add_months 2 = reference plus_months 2;
		assert reference add_years 4 = reference plus_years 4;
		assert reference add_ms 3000 = reference plus_ms 3000;

		assert reference subtract_seconds 46 = reference minus_seconds 46;
		assert reference subtract_minutes 31 = reference minus_minutes 31;
		assert reference subtract_hours 2 = reference minus_hours 2;
		assert reference subtract_days 10 = reference minus_days 10;
		assert reference subtract_weeks 1 = reference minus_weeks 1;
		assert reference subtract_months 3 = reference minus_months 3;
		assert reference subtract_years 26 = reference minus_years 26;
		assert reference subtract_ms 1000 = reference minus_ms 1000;
	}

	test "Adding then subtracting gives back the original date" {
		assert (reference plus_days 400) minus_days 400 = reference;
		assert (reference plus_hours 1000) minus_hours 1000 = reference;
		assert (reference plus_years 7) minus_years 7 = reference;
		assert (reference plus_ms 123000) minus_ms 123000 = reference;
		// a negative amount goes the other way
		assert reference plus_days -20 = reference minus_days 20;
	}

	test "Calendar shifts respect the length of months and years" {
		// there is no 31st of February
		assert date("2026-01-31T00:00:00") plus_months 1 = date("2026-02-28T00:00:00");
		assert date("2024-01-31T00:00:00") plus_months 1 = date("2024-02-29T00:00:00");
		// nor a 29th of February outside of leap years
		assert date("2024-02-29T00:00:00") plus_years 1 = date("2025-02-28T00:00:00");
		assert date("2024-02-29T00:00:00") plus_years 4 = date("2028-02-29T00:00:00");
		// units roll over
		assert date("2026-12-31T23:59:59") plus_seconds 1 = date("2027-01-01T00:00:00");
		assert date("2026-03-01T00:00:00") minus_days 1 = date("2026-02-28T00:00:00");
		assert date("2024-03-01T00:00:00") minus_days 1 = date("2024-02-29T00:00:00");
	}

	test "Durations can be added with the arithmetic operators" {
		assert reference + 3600 = reference plus_hours 1;
		assert reference + 1 #h = reference plus_hours 1;
		assert reference + 90 #mn = date("2026-03-15T12:00:45");
		assert reference - 1 #h = date("2026-03-15T09:30:45");
		assert reference + 1 #day = reference plus_days 1;
		assert reference + 1 #week = reference plus_weeks 1;
	}

	test "Time between two dates" {
		date later <- date("2028-06-20T12:00:00");
		assert years_between(reference, later) = 2;
		assert months_between(reference, later) = 27;
		assert milliseconds_between(reference, reference plus_seconds 2) = 2000.0;
		assert milliseconds_between(reference, reference) = 0.0;

		// only complete units are counted
		assert years_between(reference, reference plus_months 11) = 0;
		assert months_between(reference, reference plus_days 20) = 0;

		// the difference of two dates is a duration in seconds
		assert (reference plus_days 1) - reference = 86400.0;
		assert (reference plus_days 1) - reference = 1 #day;
		assert reference - (reference plus_hours 1) = -3600.0;
		assert reference - reference = 0.0;
	}

	test "Calendar attributes" {
		assert reference.year = 2026;
		assert reference.month = 3;
		assert reference.day = 15;
		assert reference.hour = 10;
		assert reference.minute = 30;
		assert reference.second = 45;

		// the 15th of March 2026 is a Sunday, the 7th day of the week
		assert reference.day_of_week = 7;
		assert date("2026-03-16T00:00:00").day_of_week = 1;
		assert reference.day_of_year = 74;
		assert date("2026-01-01T00:00:00").day_of_year = 1;
		assert date("2026-12-31T00:00:00").day_of_year = 365;
		assert date("2024-12-31T00:00:00").day_of_year = 366;
		assert reference.week_of_year = 11;

		assert reference.days_in_month = 31;
		assert date("2026-02-10T00:00:00").days_in_month = 28;
		assert date("2024-02-10T00:00:00").days_in_month = 29;
		assert not reference.leap;
		assert date("2024-01-01T00:00:00").leap;
		assert not date("1900-01-01T00:00:00").leap;
		assert date("2000-01-01T00:00:00").leap;

		assert reference.minute_of_day = 630;
		assert reference.second_of_day = 37845;
		// the date without its time
		assert reference.date = date("2026-03-15T00:00:00");
	}

	test "Building dates" {
		assert date([2026, 3, 15, 10, 30, 45]) = reference;
		assert date([2026, 3, 15]) = date("2026-03-15T00:00:00");
		assert date("2026-03-15") = date("2026-03-15T00:00:00");
		// with an explicit pattern
		assert date("15/03/2026", "dd/MM/yyyy") = date("2026-03-15T00:00:00");
		assert date("2026.03.15 10h30", "yyyy.MM.dd HH'h'mm") = date("2026-03-15T10:30:00");
		assert is_error(date("not a date"));
	}

	test "Formatting dates" {
		assert string(reference) = "2026-03-15 10:30:45";
		assert string(reference, "yyyy/MM/dd HH:mm") = "2026/03/15 10:30";
		assert string(reference, "dd MMMM yyyy", "en") = "15 March 2026";
		assert string(reference, "dd MMMM yyyy", "fr") = "15 mars 2026";
		assert string(reference, "HH'h'mm") = "10h30";
		// a date survives being formatted and parsed again
		assert date(string(reference, "yyyy-MM-dd HH:mm:ss"), "yyyy-MM-dd HH:mm:ss") = reference;
	}

	test "Ordering dates" {
		date earlier <- reference minus_days 1;
		date later <- reference plus_days 1;
		assert earlier < reference;
		assert later > reference;
		assert reference <= reference;
		assert reference >= reference;
		assert reference != later;
		assert reference between (earlier, later);
		assert not (earlier between (reference, later));
		assert ([later, reference, earlier] sort_by each) = [earlier, reference, later];
	}
}
