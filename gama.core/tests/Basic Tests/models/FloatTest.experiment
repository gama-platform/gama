/**
* Name: FloatTest
* Author: Antigravity
* Description: Tests common properties and operations on floating-point numbers
* Tags: float, math, test
*/

experiment FloatTest type: test autorun: true {
	
	test "Float Precision and Rounding" {
		float f1 <- 3.14159;
		
		assert round(f1) = 3;
		assert round(3.6) = 4;
		assert round(-3.6) = -4;
		assert round(-3.1) = -3;
		
		assert floor(f1) = 3.0;
		assert ceil(f1) = 4.0;
		
		// String formatting
		assert (f1 with_precision 2) = 3.14;
		assert (f1 with_precision 4) = 3.1416;
	}
	
	test "Float Arithmetic and Math Functions" {
		assert 5.0 / 2.0 = 2.5;
		assert 5 / 2.0 = 2.5; // Mixed typing
		
		assert sqrt(16.0) = 4.0;
		assert cos(0.0) = 1.0;
		assert sin(90.0) = 1.0; // Trigonometry functions in GAMA use degrees
		
		assert abs(-5.5) = 5.5;
		assert exp(0.0) = 1.0;
		assert (ln(exp(1.0)) with_precision 2) = 1.0;
	}
	
	test "Float Comparisons" {
		assert 3.5 > 3.0;
		assert 3.5 <= 4.0;
		assert 10.0 = 10.0;
		assert 10.0 != 10.1;
		
		// Min and max
		assert min([3.5, 4.0, 1.0]) = 1.0;
		assert max([3.5, 4.0, 1.0]) = 4.0;
	}
}
