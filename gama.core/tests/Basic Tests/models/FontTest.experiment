/**
* Name: FontTest
* Author: Antigravity
* Description: Tests the font data type and attributes
* Tags: font, graphics, test
*/

experiment FontTest type: test autorun: true {
	
	test "Font Creation and Attributes" {
		font f1 <- font("Arial", 14, #bold);
		font f2 <- font("Helvetica", 12.0, #italic);
		
		assert f1.name = "Arial";
		assert f1.size = 14.0;
		assert f1.style = #bold;
		
		assert f2.size = 12.0;
		assert f2.style = #italic;
		
		// Equality
		font f3 <- font("Arial", 14, #bold);
		assert f1 = f3;
		assert f1 != f2;
	}
}
