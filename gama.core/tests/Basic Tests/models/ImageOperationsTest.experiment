/**
* Name: ImageOperationsTest
* Author: Antigravity
* Description: Tests the image file loading and property retrieval operators
* Tags: image, graphics, file, test
*/

experiment ImageOperationsTest type: test autorun: true {
	
	test "Image Matrix Conversions" {
		// Creating a 2x2 matrix of colors
		matrix<rgb> img_matrix <- matrix<rgb>([
			[#red, #blue],
			[#green, #yellow]
		]);
		
		assert img_matrix.columns = 2;
		assert img_matrix.rows = 2;
		
		assert img_matrix[0, 0] = #red;
		assert img_matrix[1, 1] = #yellow;
		
		// In GAMA, you can write matrices of colors to images, but we test the matrix manipulation here.
		// Grayscale conversions (simulated)
		list<rgb> as_list <- img_matrix collect (each.darker);
		assert length(as_list) = 4;
		assert as_list[0] != #red; // Should be darker
	}
}
