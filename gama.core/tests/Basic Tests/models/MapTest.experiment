/**
* Name: MapTest
* Author: Antigravity
* Description: Tests common properties of maps (dictionaries)
* Tags: map, test
*/

experiment MapTest type: test autorun: true {
	
	test "Map Creation and Access" {
		map<string, int> m1 <- ["a"::1, "b"::2, "c"::3];
		assert m1["a"] = 1;
		assert m1["b"] = 2;
		assert m1["c"] = 3;
		
		assert length(m1) = 3;
		assert m1.keys = ["a", "b", "c"];
		assert m1.values = [1, 2, 3];
	}
	
	test "Map Modification" {
		map<string, int> m1 <- ["a"::1, "b"::2];
		
		// Add elements
		m1["c"] <- 3;
		assert length(m1) = 3;
		assert m1["c"] = 3;
		
		// Update elements
		m1["a"] <- 10;
		assert m1["a"] = 10;
		
		// Remove elements
		remove key: "b" from: m1;
		assert length(m1) = 2;
		assert m1.keys = ["a", "c"];
		assert m1.values = [10, 3];
		
		// Remove all elements
		m1 <- [];
		assert length(m1) = 0;
		assert empty(m1) = true;
	}
	
	test "Map Iterators" {
		map<string, int> m1 <- ["a"::1, "b"::2, "c"::3, "d"::4];
		
		// Collect
		list<int> l1 <- m1 collect (each * 10);
		assert l1 = [10, 20, 30, 40];
		
		// Count
		int c1 <- m1 count (each > 2);
		assert c1 = 2;
		
		// Where / Select
		list<int> l2 <- m1 where (each > 2);
		assert l2 = [3, 4];
		
		// Any / All using empty/where
		assert !empty(m1.values where (each > 3)) = true;
		assert length(m1.values where (each > 0)) = 4;
		assert length(m1.values where (each > 3)) = 1;
	}
	
	test "Map Combinations" {
		map<string, int> m1 <- ["a"::1, "b"::2];
		map<string, int> m2 <- ["c"::3, "d"::4];
		
		map<string, int> m3 <- m1 + m2;
		assert length(m3) = 4;
		assert m3["a"] = 1;
		assert m3["c"] = 3;
		
		map<string, int> m4 <- m3 - ["c"::3];
		assert length(m4) = 3;
		assert m4.keys contains "c" = false;
	}
}
