/**
* Name: MatrixTest
* Author: Antigravity
* Description: Tests the matrix data type and operations in GAMA
* Tags: matrix, math, test
*/

experiment MatrixTest type: test autorun: true {
	
	test "Matrix Creation and Access" {
		matrix<int> m1 <- matrix([[1, 2], [3, 4]]);
		
		// matrices are indexed [column, row], and each inner list is a column
		assert m1[0, 0] = 1;
		assert m1[0, 1] = 2;
		assert m1[1, 0] = 3;
		assert m1[1, 1] = 4;
		
		// Row and Column access
		assert m1.rows = 2;
		assert m1.columns = 2;
	}
	
	test "Matrix Operations" {
		matrix<int> m1 <- matrix([[1, 1], [1, 1]]);
		matrix<int> m2 <- matrix([[2, 2], [2, 2]]);
		
		// Element-wise operations
		matrix<int> m_sum <- m1 + m2;
		assert m_sum[0, 0] = 3;
		assert m_sum[1, 1] = 3;
		
		matrix<int> m_sub <- m2 - m1;
		assert m_sub[0, 0] = 1;
		
		// Scalar operations
		matrix<int> m_scale <- m1 * 5;
		assert m_scale[0, 0] = 5;
		
		matrix<float> m_div <- m2 / 2;
		assert m_div[0, 0] = 1.0;
	}
	
	test "Matrix Iterations" {
		matrix<int> m1 <- matrix([[1, 2], [3, 4]]);
		
		list<int> l1 <- m1 collect (each * 10);
		assert length(l1) = 4;
		assert (l1 sort_by each) = [10, 20, 30, 40];
		
		int sum_elements <- m1 sum_of each;
		assert sum_elements = 10;
		
		assert !empty(list(m1) where (each > 0)) = true;
		assert !empty(list(m1) where (each > 3)) = true;
	}
	
	test "Matrix Determinant and Transpose" {
		matrix<float> m1 <- matrix([[1.0, 2.0], [3.0, 4.0]]);
		
		assert (determinant(m1) with_precision 1) = -2.0;
		
		matrix<float> m2 <- transpose(m1);
		assert m2[0, 1] = m1[1, 0];
		assert m2[1, 0] = m1[0, 1];
		assert m2[0, 1] = 3.0;
		assert m2[1, 0] = 2.0;
	}
}
