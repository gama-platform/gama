/**
* Name: PairTest
* Author: Antigravity
* Description: Tests the pair data type in GAMA
* Tags: pair, test
*/

experiment PairTest type: test autorun: true {
	
	test "Pair Creation and Access" {
		pair<string, int> p1 <- "key"::10;
		pair<float, bool> p2 <- 3.14::true;
		
		assert p1.key = "key";
		assert p1.value = 10;
		
		assert p2.key = 3.14;
		assert p2.value = true;
	}
	
	test "Pair Equality and Comparison" {
		pair<string, int> p1 <- "a"::1;
		pair<string, int> p2 <- "a"::1;
		pair<string, int> p3 <- "b"::2;
		
		assert p1 = p2;
		assert p1 != p3;
	}
	
	test "Pair as List and Map Element" {
		// '[key::value, ...]' is a map literal; 'pairs' exposes it as a list of pairs
		map<string, int> src <- ["x"::1, "y"::2];
		list<pair<string, int>> l1 <- src.pairs;
		assert length(l1) = 2;
		assert l1[0].key = "x";
		assert l1[0].value = 1;
		
		// Map creation from list of pairs
		map<string, int> m1 <- map(["a"::10, "b"::20]);
		assert m1["a"] = 10;
		assert length(m1) = 2;
	}
}
