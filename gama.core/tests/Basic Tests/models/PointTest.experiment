/**
* Name: PointTest
* Author: Antigravity
* Description: Tests common properties of points
* Tags: point, spatial, test
*/

experiment PointTest type: test autorun: true {
	
	test "Point Creation and Equality" {
		point p1 <- {1, 2, 3};
		point p2 <- {1.0, 2.0, 3.0};
		point p3 <- {1, 2};
		
		assert p1 = p2;
		assert p1 != p3;
		
		assert p1.x = 1;
		assert p1.y = 2;
		assert p1.z = 3;
		
		assert p3.z = 0;
	}
	
	test "Point Arithmetic" {
		point p1 <- {1, 2, 3};
		point p2 <- {4, 5, 6};
		
		assert p1 + p2 = {5, 7, 9};
		assert p1 - p2 = {-3, -3, -3};
		assert p1 * 2 = {2, 4, 6};
		assert p2 / 2 = {2.0, 2.5, 3.0};
		
		assert p2 / 2.0 = {2.0, 2.5, 3.0};
		assert {5, 7.5} / 2.5 = {2, 3};
	}
	
	test "Point Distance and Norm" {
		point p1 <- {0, 0};
		point p2 <- {3, 4};
		
		// Distance is typically distance_to, but let's check basic Euclidean math
		assert p1 distance_to p2 = 5;
		assert p2 distance_to p1 = 5;
		
		assert norm({3, 4}) = 5.0;
	}
	
	test "Point Logical and Comparisons" {
		point p1 <- {1, 2};
		point p2 <- {3, 4};
		
		assert (p1 < p2) = true;
		assert (p1 > p2) = false;
		assert (p1 <= {1, 2}) = true;
		assert (p1 >= {1, 2}) = true;
	}
}
