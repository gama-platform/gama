/**
* Name: SpatialAdvancedTest
* Author: Antigravity
* Description: Tests advanced spatial operators (buffer, convex_hull, clean, CRS)
* Tags: spatial, geometry, topology, test
*/

experiment SpatialAdvancedTest type: test autorun: true {
	
	test "Buffer and Geometric Transformations" {
		geometry pt <- point({50, 50});
		
		// Buffer of a point is a polygon (roughly circular)
		geometry buf <- pt + 10.0;
		assert buf.area > 0;
		// A circle of radius 10 has area ~314
		assert (buf.area > 310.0 and buf.area < 320.0);
		
		geometry negative_buf <- square(10) - 2.0; 
		assert negative_buf.area < 100.0;
	}
	
	test "Convex Hull" {
		list<point> pts <- [{0, 0}, {0, 10}, {10, 10}, {10, 0}, {5, 5}];
		geometry poly <- polygon(pts);
		
		// The convex hull of the square with a point inside is just the square
		geometry hull <- convex_hull(poly);
		assert hull.area = 100.0; // The bounding square 10x10
		assert length(hull.points) = 5; // 4 corners + 1 closing point
	}
	
	test "Geometry Cleaning and Validity" {
		// Create a self-intersecting polygon (bowtie)
		geometry bowtie <- polygon([{0, 0}, {10, 10}, {0, 10}, {10, 0}]);
		
		geometry cleaned <- clean(bowtie);
		// the self-intersecting ring has no usable area, the cleaned geometry does
		assert bowtie.area = 0.0;
		assert cleaned != nil;
		assert cleaned.area > 0.0;
	}

	test "Spatial Casting" {
		// From list of points to geometry
		geometry l1 <- line([{0,0}, {10,10}]);
		assert l1 != nil;
		assert l1.perimeter > 14.0; // sqrt(200) = 14.14
		
		geometry p1 <- polygon([{0,0}, {10,10}, {0, 10}]);
		assert p1.area = 50.0;
	}
	
	test "Standard Shape Generation" {
		geometry rect <- rectangle(10, 5);
		assert rect.area = 50.0;
		
		geometry tri <- triangle(10);
		assert tri.area > 0;
		
		geometry box <- box(10, 10, 10);
		assert box.volume = 1000.0;
	}
	
	test "Translations and Scalings" {
		geometry rect <- rectangle(10, 5) at_location {0, 0};
		geometry trans <- rect translated_by {10, 10};
		assert trans.location = {10, 10};
		
		geometry scaled <- rect scaled_by 2.0;
		// both dimensions are doubled, so the area is multiplied by 4
		assert scaled.area = 200.0;
		assert scaled.width = 20.0;
		assert scaled.height = 10.0;
	}
}
