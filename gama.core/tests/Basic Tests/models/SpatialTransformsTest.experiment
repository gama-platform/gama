/**
* Name: SpatialTransformsTest
* Author: Antigravity
* Description: Tests advanced geometric transformations and location sampling
* Tags: spatial, geometry, transformations, test
*/

experiment SpatialTransformsTest type: test autorun: true {
	
	test "Random Location Sampling" {
		geometry sq <- square(10) at_location {5, 5}; // bounds: 0 to 10
		
		point p <- any_location_in(sq);
		
		// The point should be inside the square
		assert (p.x >= 0.0 and p.x <= 10.0);
		assert (p.y >= 0.0 and p.y <= 10.0);
		
		assert (sq covers p) = true;
	}
	
	test "Triangulation and Voronoi" {
		list<point> pts <- [{0,0}, {10,10}, {0,10}, {10,0}, {5,5}];
		
		// Voronoi tessellation returns a list of polygons based on a list of points
		list<geometry> voronoi_polys <- voronoi(pts);
		
		assert length(voronoi_polys) > 0;
		// The number of voronoi cells should equal the number of points (mostly)
		assert length(voronoi_polys) = 5;
		
		// Triangulation of points
		list<geometry> triangles <- triangulate(pts);
		assert length(triangles) > 0;
		// Every returned geometry should be a triangle (3 points + 1 closing = 4)
		assert length(triangles[0].points) = 4;
	}
	
	test "Geometry Smoothing and Skeletonization" {
		geometry box <- square(10);
		
		geometry smoothed <- smooth(box, 0.5);
		assert smoothed != nil;
		// A smoothed square usually has more points than 5 (4 corners + closing)
		assert length(smoothed.points) > 5;
		
		geometry skeleton <- skeletonize(box);
		assert skeleton != nil;
		// The skeleton of a square is a set of line segments (multiline)
		assert skeleton.area = 0.0;
	}
}
