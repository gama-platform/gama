/**
* Name: TryCatchTest
* Author: Antigravity
* Description: Tests the exception handling syntax (try/catch)
* Tags: exception, try, catch, test
*/

experiment TryCatchTest type: test autorun: true {
	
	test "Basic Try Catch" {
		bool caught <- false;
		try {
			int a <- 10 / 0; // Division by zero
		} catch {
			caught <- true;
		}
		
		assert caught = true;
	}
	
	test "No Exception Thrown" {
		bool caught <- false;
		try {
			int a <- 10 / 2;
		} catch {
			caught <- true;
		}
		
		assert caught = false;
	}
	
	test "Catching Custom Errors" {
		bool caught <- false;
		try {
			error "Custom error message";
		} catch {
			caught <- true;
		}
		assert caught = true;
	}
}
