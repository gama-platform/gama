 libs/SPARQL/jena 5.5.0/jena-core-5.5.0.jar,
 libs/SPARQL/jena 5.5.0/jena-iri-5.5.0.jar,
 libs/SPARQL/libthrift-0.22.0.jar,
 libs/SPARQL/caffeine-3.2.3.jar,
 libs/SPARQL/com.google.gson-2.9.1.jar,
 libs/geotools 33.4/commons-dbcp-1.4.jar,
 libs/geotools 33.4/commons-pool-1.5.4.jar,
 libs/geotools 33.4/gt-geopkg-33.4.jar,
 libs/geotools 33.4/gt-jdbc-33.4.jar,
 libs/geotools 33.4/gt-jdbc-mysql-33.4.jar,
