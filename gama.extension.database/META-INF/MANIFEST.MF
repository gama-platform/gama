 gama.extension.database.gaml.species,
 gama.extension.database.utils,
 gama.extension.database.utils.sql
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-25
Bundle-Activator: gama.extension.database.DatabaseActivator
Automatic-Module-Name: gama.extension.database
Bundle-ClassPath: .,
