/**
* Name: ImageAdvancedTest
* Description: Tests the operators contributed by the image extension. Transformations are
*   applied to in-memory images (the 'image' type), which is what these operators accept.
* Tags: image, extension, test
*/

experiment ImageAdvancedTest type: test autorun: true {

	test "Image creation and dimensions" {
		image blank <- image(4, 4);
		assert blank != nil;
		assert blank.width = 4;
		assert blank.height = 4;

		image colored <- image(8, 2, #red);
		assert colored.width = 8;
		assert colored.height = 2;
	}

	test "Colour transformations keep the dimensions" {
		image img <- image(4, 4, #red);

		image gray <- grayscale(img);
		assert gray != nil;
		assert gray.width = 4;
		assert gray.height = 4;

		image drk <- darker(img, 0.5);
		assert drk != nil;
		assert drk.width = 4;

		image brt <- brighter(img);
		assert brt != nil;
		assert brt.width = 4;

		image tinted <- img tinted_with #blue;
		assert tinted != nil;
		assert tinted.width = 4;
	}

	test "Convolution filters keep the dimensions" {
		image img <- image(4, 4, #red);

		image blur <- blurred(img);
		assert blur != nil;
		assert blur.width = 4;

		image sharp <- sharpened(img);
		assert sharp != nil;
		assert sharp.width = 4;
	}

	test "Flipping keeps the dimensions" {
		image img <- image(8, 2, #green);

		image flipped <- horizontal_flip(img);
		assert flipped != nil;
		assert flipped.width = 8;
		assert flipped.height = 2;
	}

	test "Rotating by a quarter turn swaps the dimensions" {
		image img <- image(8, 2, #green);
		image rotated <- img rotated_by 90.0;
		assert rotated != nil;
		assert rotated.width = 2;
		assert rotated.height = 8;
	}

	// The pixels of an image are read by casting it to a matrix of ints, each of them encoding a color

	test "A filled image has the same color everywhere" {
		matrix<int> pixels <- matrix(image(4, 2, rgb(10, 20, 30)));
		assert pixels.columns = 4;
		assert pixels.rows = 2;
		assert rgb(pixels[0, 0]) = rgb(10, 20, 30);
		assert rgb(pixels[3, 1]) = rgb(10, 20, 30);
		assert remove_duplicates(list(pixels)) = [int(rgb(10, 20, 30))];

		// an image created without a color is transparent
		matrix<int> blank_pixels <- matrix(image(2, 2));
		assert rgb(blank_pixels[0, 0]).alpha = 0;

		// two images with the same pixels have equal matrices
		assert matrix(image(4, 2, #red)) = matrix(image(4, 2, #red));
		assert matrix(image(4, 2, #red)) != matrix(image(4, 2, #blue));
	}

	test "Colour transformations change the pixels" {
		image red_image <- image(4, 2, #red);

		rgb darkened <- rgb(matrix(darker(red_image, 0.5))[0, 0]);
		assert darkened = rgb(127, 0, 0);
		rgb slightly_darkened <- rgb(matrix(darker(red_image))[0, 0]);
		assert slightly_darkened.red < 255 and slightly_darkened.red > darkened.red;

		rgb brightened <- rgb(matrix(brighter(image(4, 2, rgb(100, 100, 100))))[0, 0]);
		assert brightened.red > 100;
		assert brightened.red = brightened.green and brightened.green = brightened.blue;

		rgb grey <- rgb(matrix(grayscale(red_image))[0, 0]);
		assert grey.red = grey.green and grey.green = grey.blue;
		assert grey.red > 0 and grey.red < 255;

		// the ratio is the strength of the tint
		assert rgb(matrix(tinted_with(red_image, #blue, 1.0))[0, 0]) = #blue;
		assert rgb(matrix(tinted_with(red_image, #blue, 0.0))[0, 0]) = #red;
	}

	test "Blending two images mixes their pixels" {
		image red_image <- image(4, 2, #red);
		image blue_image <- image(4, 2, #blue);
		rgb mixed <- rgb(matrix(blend(red_image, blue_image, 0.5))[0, 0]);
		assert mixed.red > 120 and mixed.red < 135;
		assert mixed.blue > 120 and mixed.blue < 135;
		assert mixed.green = 0;
		// the ratio is the weight of the second image
		assert rgb(matrix(blend(red_image, blue_image, 1.0))[0, 0]) = #blue;
		assert rgb(matrix(blend(red_image, blue_image, 0.0))[0, 0]) = #red;
	}

	test "Geometric transformations keep the color of a uniform image" {
		image red_image <- image(4, 2, #red);
		assert rgb(matrix(horizontal_flip(red_image))[0, 0]) = #red;
		assert rgb(matrix(vertical_flip(red_image))[3, 1]) = #red;
		assert rgb(matrix(blurred(red_image))[1, 1]) = #red;
		assert rgb(matrix(sharpened(red_image))[1, 1]) = #red;
		assert rgb(matrix(red_image rotated_by 90)[0, 0]) = #red;
	}

	test "Resizing and cropping" {
		image red_image <- image(4, 2, #red);
		image doubled <- red_image * 2;
		assert doubled.width = 8;
		assert doubled.height = 4;
		assert rgb(matrix(doubled)[7, 3]) = #red;

		image resized <- with_size(red_image, 8, 4);
		assert resized.width = 8;
		assert resized.height = 4;
		// giving one dimension keeps the proportions
		assert with_width(red_image, 8).height = 4;
		assert with_height(red_image, 4).width = 8;

		image cropped <- cropped_to(red_image, 0, 0, 2, 1);
		assert cropped.width = 2;
		assert cropped.height = 1;
		assert rgb(matrix(cropped)[1, 0]) = #red;
		// the original is left untouched
		assert red_image.width = 4;
		assert red_image.height = 2;
	}
}
