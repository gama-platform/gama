Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Serialize
Bundle-SymbolicName: gama.extension.serialize;singleton:=true
Bundle-Version: 0.0.0.qualifier
Require-Bundle: gama.core,
 gama.dependencies
Bundle-ClassPath: .,
 libs/afs-2.1.3.jar,
 libs/base-2.1.3.jar,
 libs/persistence-2.1.3.jar,
 libs/persistence-binary-2.1.3.jar,
 libs/serializer-2.1.3.jar,
 libs/slf4j-api-2.0.12.jar
Export-Package: gama.extension.serialize,
 gama.extension.serialize.binary,
 gama.extension.serialize.gaml
Import-Package: org.osgi.framework;version="1.10.0"
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-25
Automatic-Module-Name: gama.extension.serialize
Bundle-Activator: gama.extension.serialize.SerializeActivator
