/**
* Name: SerializeAdvancedTest
* Author: Antigravity
* Description: Tests that values survive a round trip through the serialisation operators (gaml, json, binary)
* Tags: serialize, extension, test
*/
model SerializeAdvancedTestModel

species serialised_agent {
	int amount <- 3;
	string label <- "initial";
}

experiment SerializeAdvancedTest type: test autorun: true {

	test "to_gaml produces the GAML literal of a value" {
		assert to_gaml(12) = "12";
		assert to_gaml(3.5) = "3.5";
		assert to_gaml(true) = "true";
		assert to_gaml(nil) = "nil";
		assert to_gaml("text") = "'text'";
		assert to_gaml([1, 2, 3]) = "[1,2,3]";
		assert to_gaml(["a"::1]) = "map(['a'::1])";
		assert to_gaml(1::2) = "1::2";
		assert to_gaml({1, 2}) = "{1.0,2.0,0.0}";
		assert to_gaml(#red) = "#red";
		assert to_gaml(matrix([[1, 2], [3, 4]])) = "matrix<int>([[1,2],[3,4]])";
	}

	test "from_gaml evaluates a GAML expression" {
		assert from_gaml("12") = 12;
		assert from_gaml("[1, 2] + [3]") = [1, 2, 3];
		assert from_gaml("3 * 4") = 12;
		assert from_gaml("'a' + 'b'") = "ab";
	}

	test "Values survive a GAML round trip" {
		assert from_gaml(to_gaml(12)) = 12;
		assert from_gaml(to_gaml(3.5)) = 3.5;
		assert from_gaml(to_gaml("text")) = "text";
		assert from_gaml(to_gaml([1, 2, 3])) = [1, 2, 3];
		assert from_gaml(to_gaml(["a"::1, "b"::2])) = ["a"::1, "b"::2];
		assert from_gaml(to_gaml(1::2)) = 1::2;
		assert from_gaml(to_gaml({1, 2, 3})) = {1, 2, 3};
		assert from_gaml(to_gaml(#red)) = #red;
		assert from_gaml(to_gaml(matrix([[1, 2], [3, 4]]))) = matrix([[1, 2], [3, 4]]);
		assert from_gaml(to_gaml(date("2026-01-02T03:04:05"))) = date("2026-01-02T03:04:05");
	}

	test "to_json produces a JSON document" {
		assert to_json(3.5) = "3.5";
		assert to_json(true) = "true";
		assert to_json(nil) = "null";
		assert to_json("text") = '"text"';
		assert to_json([1, 2, 3]) = "[1,2,3]";
		assert to_json([1, [2, [3]]]) = "[1,[2,[3]]]";
		assert to_json(["a"::1, "b"::[1, 2]]) = '{"a":1,"b":[1,2]}';
		// GAML types with no JSON equivalent are tagged with their type
		assert to_json({1, 2, 3}) = '{"gaml_type":"point","x":1.0,"y":2.0,"z":3.0}';
		assert to_json(#red) = '{"gaml_type":"rgb","red":255,"green":0,"blue":0,"alpha":255}';
		assert to_json(1::2) = '{"gaml_type":"pair<int, int>","key":1,"value":2}';
	}

	test "from_json reads a JSON document" {
		assert from_json("3") = 3;
		assert from_json('"text"') = "text";
		assert from_json("[]") = [];
		assert from_json('[1, "a", 2.5, true, null]') = [1, "a", 2.5, true, nil];

		map<string, unknown> parsed <- from_json('{"a": 1.5, "b": "s", "c": true, "d": null, "e": {"f": [1, 2]}}');
		assert parsed["a"] = 1.5;
		assert parsed["b"] = "s";
		assert parsed["c"] = true;
		assert parsed["d"] = nil;
		assert map(parsed["e"])["f"] = [1, 2];
	}

	test "Reading an invalid JSON document raises an error" {
		bool failed <- false;
		try {
			unknown parsed <- from_json("not json");
		} catch {
			failed <- true;
		}
		assert failed;
	}

	test "Values survive a JSON round trip" {
		assert from_json(to_json([1, [2, [3]]])) = [1, [2, [3]]];
		assert from_json(to_json(["a"::1, "b"::[1, 2]])) = ["a"::1, "b"::[1, 2]];
		assert from_json(to_json({1, 2, 3})) = {1, 2, 3};
		assert from_json(to_json(#red)) = #red;
		assert from_json(to_json(1::2)) = 1::2;
		assert from_json(to_json(matrix([[1, 2], [3, 4]]))) = matrix([[1, 2], [3, 4]]);
		assert from_json(to_json(date("2026-01-02T03:04:05"))) = date("2026-01-02T03:04:05");
		assert from_json(to_json(["k"::{1, 2}])) = ["k"::{1, 2}];
	}

	test "Values survive a binary round trip" {
		assert from_binary(to_binary(12)) = 12;
		assert from_binary(to_binary("text")) = "text";
		assert from_binary(to_binary(nil)) = nil;
		assert from_binary(to_binary([1, "a", 2.5, true])) = [1, "a", 2.5, true];
		assert from_binary(to_binary(["k"::{1, 2}, "c"::#red])) = ["k"::{1, 2}, "c"::#red];
		assert from_binary(to_binary(matrix([[1, 2], [3, 4]]))) = matrix([[1, 2], [3, 4]]);
		assert from_binary(to_binary(date("2026-01-02T03:04:05"))) = date("2026-01-02T03:04:05");
	}

	test "Values survive a serialize / deserialize round trip" {
		assert deserialize(serialize(3.5)) = 3.5;
		assert deserialize(serialize([1, 2, 3])) = [1, 2, 3];
		assert deserialize(serialize(["k"::[1, 2]])) = ["k"::[1, 2]];
		// the serialised form is not the textual one
		assert serialize([1, 2, 3]) != "[1,2,3]";
	}

	test "Serialising an agent to JSON does not alter the next serialisations" {
		create serialised_agent number: 1 returns: created_agents;
		string agent_json <- to_json(created_agents[0]);
		assert agent_json contains "serialised_agent";
		// the references of the agent must not leak into unrelated documents
		assert to_json([1, 2]) = "[1,2]";
		assert to_json(["a"::1]) = '{"a":1}';
		ask created_agents { do die; }
	}

	test "An agent serialised in binary is restored as the same agent" {
		create serialised_agent number: 2 returns: created_agents;
		serialised_agent ag <- created_agents[0];
		ag.amount <- 42;
		ag.label <- "changed";

		serialised_agent restored <- serialised_agent(from_binary(to_binary(ag)));
		assert restored = ag;
		assert restored != created_agents[1];
		assert restored.amount = 42;
		assert restored.label = "changed";
		ask created_agents { do die; }
	}
}
