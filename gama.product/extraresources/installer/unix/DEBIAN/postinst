#!/bin/bash

chmod a+rw -R /opt/gama-platform
chmod a+x -R /opt/gama-platform/Gama
chmod a+x -R /opt/gama-platform/headless/gama-headless.sh

# Add gama-headless.sh shortcut in PATH
ln -s /opt/gama-platform/headless/gama-headless.sh /usr/sbin/gama-headless

if command -v update-mime-database >/dev/null 2>&1; then
    update-mime-database /usr/share/mime || exit $?
else
    echo "GAMA: refresh the desktop MIME database after installing shared-mime-info." >&2
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications || exit $?
else
    echo "GAMA: refresh the application database after installing desktop-file-utils." >&2
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f /usr/share/icons/hicolor/index.theme ]; then
    gtk-update-icon-cache -q -t /usr/share/icons/hicolor || exit $?
fi