#!/bin/bash

rm /usr/sbin/gama-headless
rm -fr /opt/gama-platform

rm -f /usr/share/icons/hicolor/512x512/mimetypes/application-x-gama-model-project.png

if command -v update-mime-database >/dev/null 2>&1; then
    update-mime-database /usr/share/mime || exit $?
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications || exit $?
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f /usr/share/icons/hicolor/index.theme ]; then
    gtk-update-icon-cache -q -t /usr/share/icons/hicolor || exit $?
fi