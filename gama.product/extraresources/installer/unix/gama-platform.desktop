[Desktop Entry]
Name=Gama Platform
Comment=version 0.0.0
Exec=env GTK_OVERLAY_SCROLLING=0 GDK_BACKEND=x11 /opt/gama-platform/Gama --launcher.openFile %F
Icon=/opt/gama-platform/icon.icns
Terminal=false
Type=Application
StartupNotify=true
Categories=TextEditor;
MimeType=application/x-gama-simulation-package;
