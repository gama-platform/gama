<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- Commands -->
   <extension point="org.eclipse.ui.commands">
      <category id="gama.ui.devtools.category" name="GAMA Developer Tools"/>
      <command id="gama.ui.devtools.cleanAndRebuild" categoryId="gama.ui.devtools.category"
            name="Clean and Rebuild GAMA Plugins"
            description="Resets the annotation processor of the GAMA plugins, deletes the generated gaml folders and rebuilds everything, without any dialog">
         <commandParameter id="gama.ui.devtools.scope" name="Scope (selection or all)" optional="true"/>
      </command>
      <command id="gama.ui.devtools.checkConfiguration" categoryId="gama.ui.devtools.category"
            name="Check GAMA Plugins Configuration"
            description="Checks (and offers to repair) the configuration of the annotation processor, classpath, build.properties and manifest of the GAMA plugins"/>
      <command id="gama.ui.devtools.gamlReport" categoryId="gama.ui.devtools.category"
            name="GAML Documentation and Tests Report"
            description="Lists the GAML elements that are not documented and the operators that are not tested"/>
      <command id="gama.ui.devtools.generateTestStubs" categoryId="gama.ui.devtools.category"
            name="Generate GAML Test Stubs for Untested Operators"
            description="Writes, in models/Tests of each plugin, a GAML test model with one stub per operator reported as not tested by the annotation processor"/>
      <command id="gama.ui.devtools.rebuildProcessorJar" categoryId="gama.ui.devtools.category"
            name="Rebuild the Annotation Processor Jar"
            description="Regenerates gama.processor.jar from the sources of gama.processor and gama.annotations"/>
      <command id="gama.ui.devtools.dependencyGraph" categoryId="gama.ui.devtools.category"
            name="Package Dependency Graph..."
            description="Computes the graph of dependencies between the packages of GAMA (requires jdeps)"/>
      <command id="gama.ui.devtools.openNewWizard" categoryId="gama.ui.devtools.category" name="Open a GAMA Wizard">
         <commandParameter id="gama.ui.devtools.wizardId" name="Wizard id" optional="false"/>
      </command>
   </extension>

   <!-- Handlers -->
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="gama.ui.devtools.cleanAndRebuild" class="gama.ui.devtools.handlers.CleanAndRebuildHandler"/>
      <handler commandId="gama.ui.devtools.checkConfiguration" class="gama.ui.devtools.handlers.CheckConfigurationHandler"/>
      <handler commandId="gama.ui.devtools.gamlReport" class="gama.ui.devtools.handlers.GamlReportHandler"/>
      <handler commandId="gama.ui.devtools.generateTestStubs" class="gama.ui.devtools.handlers.GenerateTestStubsHandler"/>
      <handler commandId="gama.ui.devtools.rebuildProcessorJar" class="gama.ui.devtools.handlers.RebuildProcessorJarHandler"/>
      <handler commandId="gama.ui.devtools.dependencyGraph" class="gama.ui.devtools.handlers.DependencyGraphHandler"/>
      <handler commandId="gama.ui.devtools.openNewWizard" class="gama.ui.devtools.handlers.OpenNewWizardHandler"/>
   </extension>

   <!-- Key binding: Clean and Rebuild (all) -->
   <extension point="org.eclipse.ui.bindings">
      <key commandId="gama.ui.devtools.cleanAndRebuild" schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+M3+B"/>
   </extension>

   <!-- Menus -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu id="gama.ui.devtools.menu" label="GAMA" mnemonic="G">
            <menu id="gama.ui.devtools.menu.new" label="New" icon="icons/gama.png">
               <command commandId="gama.ui.devtools.openNewWizard" label="New GAMA Plugin..." icon="icons/gama.png" style="push">
                  <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.plugin"/>
               </command>
               <separator name="classes" visible="true"/>
               <command commandId="gama.ui.devtools.openNewWizard" label="New GAMA Skill..." icon="icons/gama.png" style="push">
                  <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.skill"/>
               </command>
               <command commandId="gama.ui.devtools.openNewWizard" label="New GAMA Operators..." icon="icons/gama.png" style="push">
                  <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.operator"/>
               </command>
               <command commandId="gama.ui.devtools.openNewWizard" label="New GAMA Action..." icon="icons/gama.png" style="push">
                  <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.action"/>
               </command>
               <command commandId="gama.ui.devtools.openNewWizard" label="New GAMA Type..." icon="icons/gama.png" style="push">
                  <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.type"/>
               </command>
               <command commandId="gama.ui.devtools.openNewWizard" label="New GAML Test Model..." icon="icons/gama.png" style="push">
                  <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.testModel"/>
               </command>
            </menu>
            <separator name="build" visible="true"/>
            <command commandId="gama.ui.devtools.cleanAndRebuild" label="Clean and Rebuild All GAMA Plugins" icon="icons/gama.png" style="push">
               <parameter name="gama.ui.devtools.scope" value="all"/>
            </command>
            <command commandId="gama.ui.devtools.cleanAndRebuild" label="Clean and Rebuild Selected Plugins" style="push">
               <parameter name="gama.ui.devtools.scope" value="selection"/>
            </command>
            <command commandId="gama.ui.devtools.checkConfiguration" style="push"/>
            <command commandId="gama.ui.devtools.rebuildProcessorJar" style="push"/>
            <separator name="reports" visible="true"/>
            <command commandId="gama.ui.devtools.gamlReport" style="push"/>
            <command commandId="gama.ui.devtools.generateTestStubs" style="push"/>
            <command commandId="gama.ui.devtools.dependencyGraph" style="push"/>
            <separator name="additions" visible="true"/>
         </menu>
      </menuContribution>
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu id="gama.ui.devtools.popup" label="GAMA" icon="icons/gama.png">
            <command commandId="gama.ui.devtools.cleanAndRebuild" label="Clean and Rebuild" style="push">
               <parameter name="gama.ui.devtools.scope" value="selection"/>
            </command>
            <command commandId="gama.ui.devtools.checkConfiguration" label="Check Configuration" style="push"/>
            <command commandId="gama.ui.devtools.gamlReport" label="Documentation and Tests Report" style="push"/>
            <command commandId="gama.ui.devtools.generateTestStubs" label="Generate Test Stubs for Untested Operators" style="push"/>
            <separator name="new" visible="true"/>
            <command commandId="gama.ui.devtools.openNewWizard" label="New GAMA Skill..." style="push">
               <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.skill"/>
            </command>
            <command commandId="gama.ui.devtools.openNewWizard" label="New GAMA Operators..." style="push">
               <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.operator"/>
            </command>
            <command commandId="gama.ui.devtools.openNewWizard" label="New GAMA Action..." style="push">
               <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.action"/>
            </command>
            <command commandId="gama.ui.devtools.openNewWizard" label="New GAMA Type..." style="push">
               <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.type"/>
            </command>
            <command commandId="gama.ui.devtools.openNewWizard" label="New GAML Test Model..." style="push">
               <parameter name="gama.ui.devtools.wizardId" value="gama.ui.devtools.wizards.testModel"/>
            </command>
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <iterate ifEmpty="false" operator="or">
                     <adapt type="org.eclipse.core.resources.IProject">
                        <test property="org.eclipse.core.resources.projectNature" value="org.eclipse.jdt.core.javanature"/>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </menu>
      </menuContribution>
   </extension>

   <!-- New wizards (also available in File > New > Other...) -->
   <extension point="org.eclipse.ui.newWizards">
      <category id="gama.ui.devtools.wizards" name="GAMA Development"/>
      <wizard id="gama.ui.devtools.wizards.plugin" category="gama.ui.devtools.wizards" name="New GAMA Plugin"
            class="gama.ui.devtools.wizards.NewGamaPluginWizard" icon="icons/gama.png" project="true">
         <description>Creates a GAMA plugin with the standard layout (src, gaml, libs, models), the annotation processor configured and a Maven pom.</description>
      </wizard>
      <wizard id="gama.ui.devtools.wizards.skill" category="gama.ui.devtools.wizards" name="New GAMA Skill"
            class="gama.ui.devtools.wizards.NewGamaSkillWizard" icon="icons/gama.png" project="false">
         <description>Creates a skill in a GAMA plugin.</description>
      </wizard>
      <wizard id="gama.ui.devtools.wizards.operator" category="gama.ui.devtools.wizards" name="New GAMA Operators"
            class="gama.ui.devtools.wizards.NewGamaOperatorWizard" icon="icons/gama.png" project="false">
         <description>Creates a class of documented GAML operators in a GAMA plugin.</description>
      </wizard>
      <wizard id="gama.ui.devtools.wizards.action" category="gama.ui.devtools.wizards" name="New GAMA Action"
            class="gama.ui.devtools.wizards.NewGamaActionWizard" icon="icons/gama.png" project="false">
         <description>Creates a skill with a single action in a GAMA plugin.</description>
      </wizard>
      <wizard id="gama.ui.devtools.wizards.type" category="gama.ui.devtools.wizards" name="New GAMA Type"
            class="gama.ui.devtools.wizards.NewGamaTypeWizard" icon="icons/gama.png" project="false">
         <description>Creates a GAML type and its value class in a GAMA plugin.</description>
      </wizard>
      <wizard id="gama.ui.devtools.wizards.testModel" category="gama.ui.devtools.wizards" name="New GAML Test Model"
            class="gama.ui.devtools.wizards.NewGamlTestModelWizard" icon="icons/gama.png" project="false">
         <description>Creates a GAML test model in models/Tests of a GAMA plugin.</description>
      </wizard>
   </extension>

   <!-- Configuration problems and their quick fix -->
   <extension id="configurationProblem" name="GAMA Plugin Configuration Problem" point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.problemmarker"/>
      <persistent value="false"/>
      <attribute name="gamaIssueKind"/>
   </extension>
   <extension point="org.eclipse.ui.ide.markerResolution">
      <markerResolutionGenerator class="gama.ui.devtools.config.RepairMarkerResolutionGenerator"
            markerType="gama.ui.devtools.configurationProblem"/>
   </extension>

   <!-- Quick fixes on the warnings of the GAML annotation processor (missing documentation, untested operators).
        Marker resolutions match exact marker types, hence the registration on each type used by APT. -->
   <extension point="org.eclipse.ui.ide.markerResolution">
      <markerResolutionGenerator class="gama.ui.devtools.quickfix.ProcessorWarningResolutionGenerator"
            markerType="org.eclipse.jdt.apt.pluggable.core.compileProblem"/>
      <markerResolutionGenerator class="gama.ui.devtools.quickfix.ProcessorWarningResolutionGenerator"
            markerType="org.eclipse.jdt.apt.core.compile.problem"/>
      <markerResolutionGenerator class="gama.ui.devtools.quickfix.ProcessorWarningResolutionGenerator"
            markerType="org.eclipse.jdt.apt.core.nonreconcile.compile.problem"/>
      <markerResolutionGenerator class="gama.ui.devtools.quickfix.ProcessorWarningResolutionGenerator"
            markerType="org.eclipse.jdt.core.problem"/>
   </extension>

   <!-- Preferences -->
   <extension point="org.eclipse.ui.preferencePages">
      <page id="gama.ui.devtools.preferences" name="GAMA Developer Tools"
            class="gama.ui.devtools.preferences.GamaDevToolsPreferencePage"/>
   </extension>
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="gama.ui.devtools.preferences.DevToolsPreferences"/>
   </extension>

</plugin>
