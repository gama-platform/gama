<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="gama.standard.distribution">
   </extension>

   <extension point="org.eclipse.ui.propertyPages">
      <page id="gama.ui.export.projectArchive.properties" name="GAMA project archive"
            class="gama.ui.export.dialogs.ExportedModelPropertyPage">
         <enabledWhen><adapt type="org.eclipse.core.resources.IFile"><or>
            <test property="org.eclipse.core.resources.extension" value="gamp"/>
            <test property="org.eclipse.core.resources.extension" value="GAMP"/>
         </or></adapt></enabledWhen>
      </page>
      <page id="gama.ui.export.standaloneModel.properties" name="Playable model"
            class="gama.ui.export.dialogs.ExportedModelPropertyPage">
         <enabledWhen>
            <adapt type="org.eclipse.core.resources.IFile">
               <or>
                  <test property="org.eclipse.core.resources.extension" value="gamx"/>
                  <test property="org.eclipse.core.resources.extension" value="GAMX"/>
               </or>
            </adapt>
         </enabledWhen>
      </page>
   </extension>
   <extension point="org.eclipse.ui.editors">
      <editor id="gama.ui.export.projectArchive" name="GAMA project importer"
            extensions="gamp,GAMP" default="true"
            icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/files/file.gamp.svg"
            launcher="gama.ui.export.commands.ProjectArchiveLauncher">
         <contentTypeBinding contentTypeId="gama.project.archive.type"/>
      </editor>
      <editor id="gama.ui.export.standaloneModel" name="Playable model player"
            extensions="gamx,GAMX" default="true"
            icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/files/file.gamx.svg"
            launcher="gama.ui.export.commands.StandaloneModelLauncher">
         <contentTypeBinding contentTypeId="gama.exported.model.type"/>
      </editor>
   </extension>
   <extension point="org.eclipse.ui.splashHandlers">
      <splashHandler id="gama.ui.export.playerSplash"
            class="gama.ui.export.launcher.PlayerSplashHandler"/>
      <splashHandlerProductBinding productId="gama.ui.application.product"
            splashId="gama.ui.export.playerSplash"/>
   </extension>
   <extension point="org.eclipse.ui.activities">
      <activity id="gama.ui.export.homeActivity" name="Playable model home">
         <enabledWhen><systemTest property="exported_runner" value="true"/></enabledWhen>
      </activity>
      <activityPatternBinding activityId="gama.ui.export.homeActivity"
            pattern="gama\.ui\.export/gama\.ui\.export\.(perspectives|views)\.Home"/>
   </extension>
   <extension point="org.eclipse.ui.perspectives">
      <perspective id="gama.ui.export.perspectives.Home" name="Home" fixed="true"
            class="gama.ui.export.launcher.LauncherHomePerspective"/>
   </extension>
   <extension point="org.eclipse.ui.views">
      <view id="gama.ui.export.views.Home" name="Home" restorable="false"
            class="gama.ui.export.launcher.LauncherHomeView"/>
   </extension>
   <extension point="org.eclipse.core.runtime.applications" id="SimulationApplication" name="GAMA Playable Model">
      <application>
         <run class="gama.ui.export.launcher.SimulationApplication"/>
      </application>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <command id="gama.ui.export.exportProject" name="Export as GAMA project" categoryId="gama.category"/>
      <command id="gama.ui.export.importProject" name="Import GAMA project (.gamp or .zip)" categoryId="gama.category">
         <commandParameter id="gama.ui.export.projectPath" name="Project archive path" optional="true"/>
         <commandParameter id="gama.ui.export.projectGroup" name="Navigator group" optional="true"/>
      </command>
      <command id="gama.ui.export.playSelection" name="Play" categoryId="gama.category"/>
      <command id="gama.ui.export.openPackage" name="Play exported model" categoryId="gama.category">
         <commandParameter id="gama.ui.export.packagePath" name="Playable model path" optional="true"/>
      </command>
      <command id="gama.ui.export.model" name="Export as playable model" categoryId="gama.category"/>
      <command id="gama.ui.export.selectedModel" name="Export as playable model" categoryId="gama.category"/>
      <command id="gama.ui.navigator.commands.exportProjectAsSimulation" name="Export as playable model" categoryId="gama.category"/>
   </extension>
   <extension point="org.eclipse.core.expressions.definitions">
      <definition id="gama.ui.export.isProjectSelection">
         <and>
            <not><reference definitionId="gama.ui.export.isLauncher"/></not>
            <with variable="selection">
               <count value="1"/>
               <iterate ifEmpty="false">
                  <instanceof value="gama.ui.navigator.view.contents.WrappedProject"/>
               </iterate>
            </with>
         </and>
      </definition>
      <definition id="gama.ui.export.isProjectArchive">
         <with variable="selection"><count value="1"/><iterate ifEmpty="false">
            <adapt type="org.eclipse.core.resources.IFile"><or>
               <test property="org.eclipse.core.resources.extension" value="gamp"/>
               <test property="org.eclipse.core.resources.extension" value="GAMP"/>
               <test property="org.eclipse.core.resources.extension" value="zip"/>
            </or></adapt>
         </iterate></with>
      </definition>
      <definition id="gama.ui.export.isPlayableArchive">
         <with variable="selection"><count value="1"/><iterate ifEmpty="false">
            <adapt type="org.eclipse.core.resources.IFile"><or>
               <test property="org.eclipse.core.resources.extension" value="gamx"/>
               <test property="org.eclipse.core.resources.extension" value="GAMX"/>
            </or></adapt>
         </iterate></with>
      </definition>
      <definition id="gama.ui.export.isLauncher">
         <systemTest property="exported_runner" value="true"/>
      </definition>
      <definition id="gama.ui.export.isLauncherSimulation">
         <and>
            <reference definitionId="gama.ui.export.isLauncher"/>
            <reference definitionId="isInSimulationPerspective"/>
            <reference definitionId="isSimulationExisting"/>
         </and>
      </definition>
      <definition id="gama.ui.export.isModelEditor">
         <and>
            <not><reference definitionId="gama.ui.export.isLauncher"/></not>
            <with variable="activeEditorId"><equals value="gaml.compiler.Gaml"/></with>
         </and>
      </definition>
      <definition id="gama.ui.export.isModelSelection">
         <and>
            <not><reference definitionId="gama.ui.export.isLauncher"/></not>
            <with variable="selection">
               <count value="1"/>
               <iterate ifEmpty="false">
                  <or>
                     <instanceof value="gama.ui.navigator.view.contents.WrappedGamaFile"/>
                     <instanceof value="gama.ui.navigator.view.contents.WrappedExperimentContent"/>
                  </or>
               </iterate>
            </with>
         </and>
      </definition>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="gama.ui.export.exportProject" class="gama.ui.export.commands.ExportProject">
         <enabledWhen><reference definitionId="gama.ui.export.isProjectSelection"/></enabledWhen>
      </handler>
      <handler commandId="gama.ui.export.importProject" class="gama.ui.export.commands.ImportProject"/>
      <handler commandId="gama.ui.export.playSelection" class="gama.ui.export.commands.OpenSimulationPackage">
         <enabledWhen><reference definitionId="gama.ui.export.isPlayableArchive"/></enabledWhen>
      </handler>
      <handler commandId="gama.ui.export.openPackage" class="gama.ui.export.commands.OpenSimulationPackage"/>
      <handler commandId="gama.ui.export.model" class="gama.ui.export.commands.ExportSimulation">
         <activeWhen><reference definitionId="gama.ui.export.isModelEditor"/></activeWhen>
      </handler>
      <handler commandId="gama.ui.export.selectedModel" class="gama.ui.export.commands.ExportSimulation">
         <activeWhen><reference definitionId="gama.ui.export.isModelSelection"/></activeWhen>
         <enabledWhen><reference definitionId="gama.ui.export.isModelSelection"/></enabledWhen>
      </handler>
      <handler commandId="gama.ui.navigator.commands.exportProjectAsSimulation" class="gama.ui.export.commands.ExportSimulation">
         <activeWhen><reference definitionId="gama.ui.export.isProjectSelection"/></activeWhen>
         <enabledWhen><reference definitionId="gama.ui.export.isProjectSelection"/></enabledWhen>
      </handler>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:file?after=additions">
         <command commandId="gama.ui.export.importProject" label="Import GAMA project (.gamp or .zip)..."
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/import.project.svg">
            <visibleWhen checkEnabled="false"><not><reference definitionId="gama.ui.export.isLauncher"/></not></visibleWhen>
         </command>
         <command commandId="gama.ui.export.openPackage" label="Play exported model..."
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/navigator.play.svg"
               tooltip="Choose an external .gamx file to play without importing it into the workspace">
            <visibleWhen checkEnabled="false"><not><reference definitionId="gama.ui.export.isLauncher"/></not></visibleWhen>
         </command>
         <command commandId="gama.ui.export.model" label="Export as playable model..."
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/menu.export.svg">
            <visibleWhen checkEnabled="false"><reference definitionId="gama.ui.export.isModelEditor"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:navigator.menu?endof=additions">
         <separator name="gama.ui.export.standalone" visible="true"/>
         <command commandId="gama.ui.export.importProject" label="Import"
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/import.project.svg">
            <visibleWhen checkEnabled="false"><reference definitionId="gama.ui.export.isProjectArchive"/></visibleWhen>
         </command>
         <command commandId="gama.ui.export.playSelection" label="Play"
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/navigator.play.svg">
            <visibleWhen checkEnabled="false"><reference definitionId="gama.ui.export.isPlayableArchive"/></visibleWhen>
         </command>
         <command commandId="gama.ui.export.selectedModel" label="Export as playable model..."
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/menu.export.svg">
            <visibleWhen checkEnabled="false"><reference definitionId="gama.ui.export.isModelSelection"/></visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:menu.gama.export?after=additions">
         <command commandId="gama.ui.navigator.commands.exportProjectAsSimulation" label="As playable model..."
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/menu.export.svg">
            <visibleWhen checkEnabled="false"><reference definitionId="gama.ui.export.isProjectSelection"/></visibleWhen>
         </command>
      </menuContribution>
   </extension>
   <extension point="org.eclipse.ui.importWizards">
      <wizard category="gama.ui.wizards.GAMA" class="gama.ui.export.dialogs.ProjectArchiveWizard$Import"
            id="gama.ui.import.ExternalProject" name="GAMA project archive (.gamp or .zip)"
            icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/import.project.svg"/>
   </extension>
   <extension point="org.eclipse.ui.exportWizards">
      <wizard category="gama.ui.wizards.GAMA" class="gama.ui.export.dialogs.ProjectArchiveWizard$Export"
            id="gama.ui.export.ExternalProject" name="GAMA project (.gamp)"
            icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/files/file.gamp.svg"/>
   </extension>
</plugin>
