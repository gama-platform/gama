<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension-point id="topLevelFolders" name="Navigator top-level folders" schema="schema/topLevelFolders.exsd"/>
   <extension point="gama.ui.navigator.topLevelFolders">
      <folder id="data" name="Data" category="DATA" order="0"
            class="gama.ui.navigator.view.contents.WorkspaceFolderProvider"/>
      <folder id="demos" name="Demos" category="DEMOS" order="10"
            class="gama.ui.navigator.view.contents.WorkspaceFolderProvider"/>
      <folder id="library" name="Library" category="LIBRARY" order="20"
            class="gama.ui.navigator.view.contents.WorkspaceFolderProvider"/>
      <folder id="recipes" name="Recipes" category="RECIPES" order="30"
            class="gama.ui.navigator.view.contents.WorkspaceFolderProvider"/>
      <folder id="tutorials" name="Tutorials" category="TUTORIALS" order="40"
            class="gama.ui.navigator.view.contents.WorkspaceFolderProvider"/>
      <folder id="tests" name="Tests" category="TESTS" order="50"
            class="gama.ui.navigator.view.contents.WorkspaceFolderProvider"/>
      <folder id="user" name="User" category="USER" order="60"
            class="gama.ui.navigator.view.contents.WorkspaceFolderProvider"/>
   </extension>
   <extension point="gama.standard.distribution">
   </extension>
   <extension point="org.eclipse.ui.startup">
      <startup class="gama.ui.navigator.commands.InstallExtensionsContribution"/>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <command
            categoryId="gama.category"
            defaultHandler="gama.ui.navigator.commands.DetailsHandler"
            id="gama.ui.details"
            name="Manage extensions...">
      </command>
      <command
            categoryId="gama.category"
            defaultHandler="gama.ui.navigator.commands.InstallHandler"
            id="gama.ui.install"
            name="Install third-party extensions...">
      </command>
      <command
            categoryId="gama.category"
            defaultHandler="gama.ui.navigator.commands.UpdateHandler"
            id="gama.ui.update"
            name="Check for updates...">
      </command>
      <command
            categoryId="gama.category"
            id="gama.ui.navigator.chooseFileImport"
            name="Import individual file">
      </command>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler commandId="gama.ui.navigator.chooseFileImport"
            class="gama.ui.navigator.commands.ChooseFileImportHandler"/>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            allPopups="false"
            locationURI="menu:support?after=gama.ui.shared.help.separator2">
         <dynamic
               class="gama.ui.navigator.commands.InstallExtensionsContribution"
               id="gama.ui.install.extensions">
            <visibleWhen checkEnabled="false">
               <not>
                  <systemTest property="exported_runner" value="true"/>
               </not>
            </visibleWhen>
         </dynamic>
         <command
               commandId="gama.ui.install"
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/generic/menu.install.svg"
               label="Install third-party extensions..."
               style="push">
            <visibleWhen checkEnabled="false">
               <not>
                  <systemTest property="exported_runner" value="true"/>
               </not>
            </visibleWhen>
         </command>
         <separator
               name="gama.ui.shared.separator4"
               visible="true">
         </separator>
         <command
               commandId="gama.ui.update"
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/generic/menu.update.svg"
               label="Check for updates..."
               style="push">
            <visibleWhen checkEnabled="false">
               <not>
                  <systemTest property="exported_runner" value="true"/>
               </not>
            </visibleWhen>
         </command>
         <command
               commandId="gama.ui.details"
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/generic/menu.details.svg"
               label="Manage extensions..."
               style="push">
            <visibleWhen checkEnabled="false">
               <not>
                  <systemTest property="exported_runner" value="true"/>
               </not>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>
   <extension
         point="org.eclipse.ui.decorators">
      <decorator
            adaptable="false"
            class="gama.ui.navigator.view.NavigatorPluginDecorator"
            id="gama.ui.navigator.plugin.decorator"
            label="Contributing Plugin Decorator"
            lightweight="true"
            state="true">
         <enablement>
            <objectClass name="gama.ui.navigator.view.contents.WrappedProject"/>
         </enablement>
      </decorator>
      <decorator
            adaptable="false"
            class="gama.ui.navigator.view.NavigatorBaseLighweightDecorator"
            id="gama.ui.application.decorator"
            label="Metadata Decorator"
            lightweight="true"
            location="REPLACE"
            state="true">
         <enablement>
            <or>
               <objectClass name="gama.ui.navigator.view.contents.VirtualContent"/>
               <objectClass
                     name="gama.ui.navigator.view.contents.LinkedFile">
               </objectClass>
               <objectClass
                     name="gama.ui.navigator.view.contents.WrappedProject">
               </objectClass>
               <objectClass
                     name="gama.ui.navigator.view.contents.WrappedLink">
               </objectClass>
               <and>
                  <objectClass
                        name="org.eclipse.core.resources.IFile">
                  </objectClass>
                  <or>
                     <objectState
                           name="contentTypeId"
                           value="gama.gaml.file.type">
                     </objectState>
                     <objectState
                           name="contentTypeId"
                           value="gama.shapefile.type">
                     </objectState>
                     <objectState
                           name="contentTypeId"
                           value="gama.geopackage.type">
                     </objectState>
                     <objectState
                           name="contentTypeId"
                           value="gama.csv.file.type">
                     </objectState>
                     <objectState
                           name="contentTypeId"
                           value="gama.images.file.type">
                     </objectState>
                     <objectState
                           name="contentTypeId"
                           value="gama.shapefile.support.type">
                     </objectState>
                     <objectState
                           name="contentTypeId"
                           value="gama.osm.file.type">
                     </objectState>
                     <objectState
                           name="contentTypeId"
                           value="gama.gsim.file.type">
                     </objectState> 
                     <objectState
                           name="contentTypeId"
                           value="gama.svg.file.type">
                     </objectState>                       
                  </or>
               </and>
               <objectClass
               		 name="gama.ui.navigator.view.contents.Tag">
               </objectClass>
               <objectClass
                     name="gama.ui.navigator.view.contents.WrappedFolder">
               </objectClass>
               <objectClass
                     name="gama.ui.navigator.view.contents.TopLevelFolder">
               </objectClass>
               <objectClass
                     name="gama.ui.navigator.view.contents.UserGroupFolder">
               </objectClass>
               <objectClass
                     name="gama.ui.navigator.view.contents.WrappedFile">
               </objectClass>
               <objectClass
                     name="gama.ui.navigator.view.contents.WrappedGamaFile">
               </objectClass>
               <objectClass
                     name="gama.ui.navigator.view.contents.WrappedSyntacticContent">
               </objectClass>
            </or>
         </enablement>
      </decorator>
      <decorator
            adaptable="true"
            class="gama.ui.navigator.view.NavigatorDateLighweightDecorator"
            id="gama.ui.application.date.decorator"
            label="Date Decorator"
            lightweight="true"
            state="false">
      </decorator>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            allPopups="true"
            locationURI="popup:navigator.menu?before=group.new">
         <menu
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/navigator.new2.svg"
               id="menu.new"
               label="New...">
            <dynamic
                  class="gama.ui.navigator.view.actions.NewMenuContribution"
                  id="gama.ui.navigator.new.context">
            </dynamic>
            <visibleWhen
                  checkEnabled="false">
               <with
                     variable="selection">
                  <iterate
                        ifEmpty="true"
                        operator="and">
                     <or>
                        <instanceof
                              value="gama.ui.navigator.view.contents.WrappedProject">
                        </instanceof>
                        <instanceof
                              value="gama.ui.navigator.view.contents.WrappedFolder">
                        </instanceof>
                        <instanceof
                              value="gama.ui.navigator.view.contents.UserProjectsFolder">
                        </instanceof>
                        <instanceof
                              value="gama.ui.navigator.view.contents.UserGroupFolder">
                        </instanceof>
                     </or>
                  </iterate>
               </with>
            </visibleWhen>
         </menu>
      </menuContribution>
      <menuContribution
            allPopups="true"
            locationURI="popup:navigator.menu?after=group.new">
         <menu
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/menu.import.svg"
               id="menu.gama.import"
               label="Import..."
               mnemonic=" ">
            <command
                  commandId="gama.ui.export.chooseProjectImport"
                  icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/import.project.svg"
                  label="Project..."
                  style="push">
            </command>
            <command
                  commandId="gama.ui.navigator.chooseFileImport"
                  icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/import.disk.svg"
                  label="Individual file..."
                  style="push">
            </command>
         </menu>
         <separator
               name="gama.ui.gamaNavigator.separator1"
               visible="true">
         </separator>
         <menu
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/menu.export.svg"
               id="menu.gama.export"
               label="Export...">
            <command
                  commandId="gama.ui.export.exportProject"
                  icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/import.project.svg"
                  label="Project…"
                  style="push">
            </command>
            <visibleWhen
                  checkEnabled="false">
               <with
                     variable="selection">
                  <count value="1"/>
                  <iterate
                        ifEmpty="false"
                        operator="and">
                     <instanceof value="gama.ui.navigator.view.contents.WrappedProject"/>
                  </iterate>
               </with>
            </visibleWhen>
           
         </menu>
         <separator
               name="gama.ui.navigator.separator2"
               visible="true">
         </separator>
         <command
               commandId="org.eclipse.ui.ide.showInSystemExplorer"
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/file.reveal.svg"
               label="Reveal in OS"
               style="push">
            <visibleWhen
                  checkEnabled="false">
               <with
                     variable="selection">
                  <iterate
                        ifEmpty="false"
                        operator="and">
                     <adapt
                           type="org.eclipse.core.resources.IResource">
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
         <command
               commandId="gama.navigator.reveal"
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/file.reveal.svg"
               label="Reveal in Workspace"
               style="push">
            <visibleWhen
                  checkEnabled="false">
               <with
                     variable="selection">
                  <iterate
                        ifEmpty="false"
                        operator="and">
                     <instanceof
                           value="gama.ui.navigator.view.contents.LinkedFile">
                     </instanceof>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
         <command
               commandId="gama.navigator.convert2026"
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/file.move.svg"
               label="Convert to GAMA 2026 syntax..."
               style="push">
            <visibleWhen
                  checkEnabled="false">
               <with
                     variable="selection">
                  <iterate
                        ifEmpty="false"
                        operator="and">
                     <adapt
                           type="org.eclipse.core.resources.IResource">
                        <test
                              property="gama.navigator.needsConversion">
                        </test>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
         <command
               commandId="org.eclipse.ui.file.properties"
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/generic/action.properties.svg"
               label="Properties"
               style="push">
            <visibleWhen
                  checkEnabled="false">
               <with
                     variable="selection">
                  <iterate
                        ifEmpty="false"
                        operator="and">
                     <and>
                        <instanceof
                              value="gama.ui.navigator.view.contents.VirtualContent">
                        </instanceof>
                        <not>
                           <instanceof
                                 value="gama.ui.navigator.view.contents.UserGroupFolder">
                           </instanceof>
                        </not>
                     </and>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
         <menu
               icon="platform:/plugin/gama.ui.shared/icons_svg/light/editor/imported.in.svg"
               label="Imported by... ">
            <dynamic
                  class="gama.ui.navigator.view.actions.ImportersContributionItem"
                  id="gama.ui.navigator.dynamic1">
            </dynamic>
            <visibleWhen
                  checkEnabled="false">
               <with
                     variable="selection">
                  <iterate
                        ifEmpty="false"
                        operator="and">
                     <instanceof
                           value="gama.ui.navigator.view.contents.WrappedGamaFile">
                     </instanceof>
                  </iterate>
               </with>
            </visibleWhen>
         </menu>

      </menuContribution>
      <menuContribution
            allPopups="false"
            locationURI="menu:new?after=new">
         <dynamic
               class="gama.ui.navigator.view.actions.NewMenuContribution"
               id="gama.ui.navigator.new.main">
         </dynamic>
      </menuContribution>
   </extension>
   <extension
         point="org.eclipse.ui.navigator.viewer">
      <viewer
            viewerId="gama.ui.application.view.GamaNavigator">
         <popupMenu
                allowsPlatformContributions="true"
                id="navigator.menu">  
             <insertionPoint name="group.new"/>
             <insertionPoint
                   name="group.open"
                   separator="true"/>
             <insertionPoint name="group.openWith"/>   
             <insertionPoint name="group.copy"
                   separator="true"/>   
             <insertionPoint
                   name="group.refresh"
                   separator="true"/>
             <insertionPoint
                   name="additions"
                   separator="true">
             </insertionPoint>             
          </popupMenu>
      </viewer>
      <viewerActionBinding
            viewerId="gama.ui.application.view.GamaNavigator">
         <includes>
            <actionExtension
                  pattern="edit.actions">
            </actionExtension>
            <actionExtension
                  pattern="openclose.actions">
            </actionExtension>
            <actionExtension
                  pattern="refresh.actions">
            </actionExtension>
            <actionExtension
                  pattern="refactor.actions">
            </actionExtension>
            <actionExtension
                  pattern="open.actions">
            </actionExtension>
            <actionExtension
                  pattern="gaml.actions">
            </actionExtension>
         </includes>
         <excludes>
            <actionExtension
                  pattern="org.eclipse.ui.*">
            </actionExtension>
            <actionExtension
                  pattern="org.eclipse.team.ui.*">
            </actionExtension>
            <actionExtension
                  pattern="org.eclipse.ui.internal.navigator.resources.actions.*">
            </actionExtension>
            <actionExtension
                  pattern="org.eclipse.ui.navigator.resources.actions.*">
            </actionExtension>
            <actionExtension
                  pattern="org.eclipse.internal.ui.*">
            </actionExtension>
            <actionExtension
                  pattern="org.eclipse.team.internal.ui.*">
            </actionExtension>
            <actionExtension
                  pattern="org.eclipse.xtext.builder.action.*">
            </actionExtension>
         </excludes>
      </viewerActionBinding>
      <viewerContentBinding
            viewerId="gama.ui.application.view.GamaNavigator">
         <includes>
            <contentExtension
                  pattern="gama.application.shapefile.filter">
            </contentExtension>
            <contentExtension
                  isRoot="true"
                  pattern="gama.application.resourceVirtualNavigatorContent">
            </contentExtension>
            <contentExtension
                  pattern="gama.ui.navigator.linkHelper1">
            </contentExtension>
         </includes>
      </viewerContentBinding>
      <dragAssistant
            class="org.eclipse.ui.navigator.resources.ResourceDragAdapterAssistant"
            viewerId="gama.ui.application.view.GamaNavigator">
      </dragAssistant>
   </extension>
   <extension
         point="org.eclipse.ui.navigator.navigatorContent">
      <navigatorContent
            activeByDefault="true"
            appearsBefore="org.eclipse.ui.navigator.resourceContent"
            contentProvider="gama.ui.navigator.view.NavigatorContentProvider"
            id="gama.application.resourceVirtualNavigatorContent"
            labelProvider="gama.ui.navigator.view.NavigatorLabelProvider"
            name="Virtual GamaNavigator Content"
            priority="highest"
            providesSaveables="false">
         <triggerPoints>
            <or>
               <instanceof
                     value="gama.ui.navigator.view.contents.VirtualContent">
               </instanceof>

            </or>
         </triggerPoints>
         <possibleChildren>
            <or>
               <instanceof
                     value="gama.ui.navigator.view.contents.LinkedFile">
               </instanceof>
               <instanceof
                     value="gama.ui.navigator.view.contents.Category">
               </instanceof>
               <instanceof
                     value="gama.ui.navigator.view.contents.VirtualContent">
               </instanceof>
            </or>
         </possibleChildren>
         <commonSorter
               class="gama.ui.navigator.view.NavigatorSorter"
               id="gama.navigator.sorter">
            <parentExpression>
            <or>
               <instanceof
                     value="gama.ui.navigator.view.contents.WrappedSyntacticContent">
               </instanceof>
               <instanceof
                     value="gama.ui.navigator.view.contents.WrappedFile">
               </instanceof>
           </or>
            </parentExpression>
         </commonSorter>
         <commonSorter
               class="gama.ui.navigator.view.FileFolderSorter">
            <parentExpression>
               <instanceof
                     value="gama.ui.navigator.view.contents.WrappedContainer">
               </instanceof>
            </parentExpression>
         </commonSorter>
         <dropAssistant
               class="gama.ui.navigator.view.NavigatorDropAssistant"
               id="gama.application.dropAssistant1">
            <possibleDropTargets>
               <instanceof
                     value="java.lang.Object">
               </instanceof>
            </possibleDropTargets>
         </dropAssistant>
         <dropAssistant
               class="gama.ui.navigator.view.NavigatorResourceDropAssistant"
               id="gama.ui.navigator.dropAssistant2">
            <possibleDropTargets></possibleDropTargets>
         </dropAssistant>
      </navigatorContent>
      <commonFilter
            activeByDefault="true"
            class="gama.ui.navigator.view.NavigatorFilter"
            id="gama.application.shapefile.filter"
            name="Filters Shapefile support files"
            visibleInUI="true">
      </commonFilter>
      <actionProvider
            class="gama.ui.navigator.view.actions.EditActionProvider"
            id="edit.actions"
            overrides="org.eclipse.ui.navigator.resources.actions.EditActions"
            priority="highest">
         <enablement>
            <with
                  variable="selection">
               <iterate
                     ifEmpty="false"
                     operator="and">
                  <or>
                     <adapt
                           type="org.eclipse.core.resources.IResource">
                     </adapt>
                     <instanceof
                           value="gama.ui.navigator.view.contents.VirtualContent">
                     </instanceof>
                  </or>
               </iterate>
            </with>
         </enablement>
      </actionProvider>
      <actionProvider
            class="gama.ui.navigator.view.actions.OpenCloseActionProvider"
            id="openclose.actions"
            priority="highest">
         <enablement>
            <with
                  variable="selection">
               <iterate
                     ifEmpty="false"
                     operator="and">
                  <adapt
                        type="org.eclipse.core.resources.IProject">
                  </adapt>
               </iterate>
            </with>
         </enablement>
      </actionProvider>
      <actionProvider
            class="gama.ui.navigator.view.actions.RefreshActionProvider"
            id="refresh.actions">
         <enablement>
            <with
                  variable="selection">
               <iterate
                     ifEmpty="true"
                     operator="and">
                  <or>
                     <instanceof
                           value="gama.ui.navigator.view.contents.VirtualContent">
                     </instanceof>
                     <instanceof
                           value="gama.ui.navigator.view.contents.UserGroupFolder">
                     </instanceof>
                     <adapt
                           type="org.eclipse.core.resources.IResource">
                     </adapt>
                  </or>
               </iterate>
            </with>
         </enablement>
      </actionProvider>
      <actionProvider
            class="gama.ui.navigator.view.actions.RefactorActionProvider"
            id="refactor.actions"
            overrides="org.eclipse.ui.internal.navigator.resources.actions.RefactorActionProvider"
            priority="highest">
         <enablement>
            <with
                  variable="selection">
               <iterate
                     ifEmpty="false"
                     operator="and">
                  <adapt
                        type="org.eclipse.core.resources.IResource">
                  </adapt>
               </iterate>
            </with>
         </enablement>
      </actionProvider>
      <actionProvider
            class="gama.ui.navigator.view.actions.OpenActionProvider"
            id="open.actions">
         <enablement>
            <with
                  variable="selection">
               <iterate
                     ifEmpty="false"
                     operator="and">
                  <instanceof
                        value="gama.ui.navigator.view.contents.WrappedFile">
                  </instanceof>
               </iterate>
            </with>
         </enablement>
      </actionProvider>
      <actionProvider
            class="gama.ui.navigator.view.actions.GamlActionProvider"
            id="gaml.actions"
            priority="highest">
             <enablement>
            <with
                  variable="selection">
               <iterate
                     ifEmpty="false"
                     operator="and">
                  <instanceof
                        value="gama.ui.navigator.view.contents.WrappedSyntacticContent">
                  </instanceof>
               </iterate>
            </with>
         </enablement>
      </actionProvider>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            allowMultiple="false"
            category="gama.ui.category.gama"
            class="gama.ui.navigator.view.GamaNavigator"
            icon="platform:/plugin/gama.ui.shared/icons_svg/light/views/tabs/view.navigator.svg"
            id="gama.ui.application.view.GamaNavigator" 
            name="Models"
            restorable="true">
      </view>
   </extension>
   <extension
         point="org.eclipse.ui.newWizards">
      <category
            id="gama.ui.wizards.GAMA"
            name="GAMA">
      </category>
      <wizard
            category="gama.ui.wizards.GAMA"
            class="gama.ui.navigator.wizards.NewProjectWizard"
            hasPages="true"
            icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/new.project2.svg"
            id="gama.ui.wizards.newProjectWizard"
            name="Gama Project"
            project="true">
      </wizard>
      <wizard
            category="gama.ui.wizards.GAMA"
            class="gama.ui.navigator.wizards.NewTestExperimentWizard"
            hasPages="true"
            icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/new.model2.svg"
            id="gama.ui.wizards.NewTestExperimentWizard"
            name="Test experiment file"
            project="false">
      </wizard>
      <wizard
            category="gama.ui.wizards.GAMA"
            class="org.eclipse.ui.wizards.newresource.BasicNewFileResourceWizard"
            hasPages="true"
            icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/new.file.svg"
            id="gama.ui.wizards.newFileWizard"
            name="File"
            project="false">
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
      <wizard
            category="gama.ui.wizards.GAMA"
            class="org.eclipse.ui.wizards.newresource.BasicNewFolderResourceWizard"
            hasPages="true"
            icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/new.folder.blue.svg"
            id="gama.ui.wizards.newFolderWizard"
            name="Folder"
            project="false">
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>
   <extension
         point="org.eclipse.ui.services">
      <serviceFactory
            factoryClass="gama.ui.navigator.commands.RefreshServiceFactory">
         <service
               serviceClass="gama.ui.shared.interfaces.IRefreshHandler">
         </service>
      </serviceFactory>
   </extension>
   <extension
point="org.eclipse.core.expressions.propertyTesters">
<propertyTester
class="gama.ui.navigator.view.ClipboardTester"
id="gama.clipboard.tester"
namespace="gama"
properties="cbready"
type="java.lang.Object">
</propertyTester>
</extension>
    <extension
          point="org.eclipse.ui.navigator.linkHelper">
       <linkHelper
             class="gama.ui.navigator.view.NavigatorLinkHelper"
             id="gama.ui.navigator.linkHelper1">
          <editorInputEnablement>
             <instanceof
                   value="org.eclipse.ui.part.FileEditorInput">
             </instanceof>
          </editorInputEnablement>
          <selectionEnablement>
             <or>
                <instanceof
                      value="gama.ui.navigator.view.contents.WrappedFile">
                </instanceof>
                <instanceof
                      value="gama.ui.navigator.view.contents.WrappedGamaFile">
                </instanceof>
                <adapt
                      type="org.eclipse.core.resources.IFile">
                </adapt>
             </or>
          </selectionEnablement>
       </linkHelper>
    </extension>
    <extension
          point="org.eclipse.ui.propertyPages">
       <page
             class="gama.ui.navigator.view.properties.TopLevelFolderPropertyPage"
             id="gama.ui.navigator.properties.samplePropertyPage"
             name="Folder"
             nameFilter="*.*">
          <enabledWhen>
             <instanceof
                   value="gama.ui.navigator.view.contents.TopLevelFolder">
             </instanceof>
          </enabledWhen>
       </page>
    </extension>
    <extension
          point="org.eclipse.ui.exportWizards">
       <wizard
             category="gama.ui.wizards.GAMA"
             class="gama.ui.navigator.wizards.ZipExportWizard"
             icon="platform:/plugin/gama.ui.shared/icons_svg/light/navigator/import.archive.svg"
             id="gama.ui.export.ZipFile"
             name="External files to archive">
       </wizard>
    </extension>
    <extension
          point="org.eclipse.ui.commands">
       <command
             categoryId="gama.category"
             id="gama.navigator.reveal"
             name="Reveal in Workspace">
       </command>
       <command
             categoryId="gama.category"
             id="gama.navigator.convert2026"
             name="Convert to GAMA 2026 syntax...">
       </command>
    </extension>
    <extension
          point="org.eclipse.ui.handlers">
       <handler
             class="gama.ui.navigator.commands.RevealInWorkspace"
             commandId="gama.navigator.reveal">
          <enabledWhen>
             <with
                   variable="selection">
                <iterate
                      ifEmpty="false"
                      operator="and">
                   <instanceof
                         value="gama.ui.navigator.view.contents.LinkedFile">
                   </instanceof>
                </iterate>
             </with>
          </enabledWhen>
       </handler>
       <handler
             class="gama.ui.navigator.commands.ConvertToGama2026Handler"
             commandId="gama.navigator.convert2026">
          <enabledWhen>
             <with
                   variable="selection">
                <iterate
                      ifEmpty="false"
                      operator="and">
                   <adapt
                         type="org.eclipse.core.resources.IResource">
                   </adapt>
                </iterate>
             </with>
          </enabledWhen>
       </handler>
    </extension>
    <extension
          point="org.eclipse.core.expressions.propertyTesters">
       <propertyTester
             class="gama.ui.navigator.commands.NeedsConversionTester"
             id="gama.navigator.needsConversionTester"
             namespace="gama.navigator"
             properties="needsConversion"
             type="org.eclipse.core.resources.IResource">
       </propertyTester>
    </extension>
</plugin>
