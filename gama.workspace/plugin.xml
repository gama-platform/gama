<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.core.resources.variableResolvers">
      <variableResolver
            class="gama.workspace.CacheLocationProvider"
            variable="CACHE_LOC">
      </variableResolver>
   </extension>
      <extension
         id="nature"
         name="GAMA project"
         point="org.eclipse.core.resources.natures">
      <runtime>
         <run
               class="gama.workspace.nature.GamaNature"> 
         </run>
      </runtime>
      <content-type
            id="gama.gaml.file.type">
      </content-type>
   </extension>

   <!-- Former identifier of the GAMA nature, kept so that old projects are still understood until they are migrated -->
   <extension
         id="gamaNature"
         name="GAMA project (legacy)"
         point="org.eclipse.core.resources.natures">
      <runtime>
         <run
               class="gama.workspace.nature.GamaNature">
         </run>
      </runtime>
      <content-type
            id="gama.gaml.file.type">
      </content-type>
   </extension>

            <extension
         point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            file-extensions="shp,SHP"
            id="gama.shapefile.type"
            name="Shapefile"
            priority="high">
      </content-type>
      <content-type
            file-extensions="gpkg,GPKG"
            id="gama.geopackage.type"
            name="GeoPackage"
            priority="high">
      </content-type>
      <content-type
            default-charset="UTF-8"
            file-extensions="qml,QML,cpg,CPG,prj,shx,dbf,xml,sbn,sbx,qix,qpj,fix,PRJ,SHX,DBF,XML,SBN,SBX,QIX,QPJ,FIX,gfs,GFS,xsd,XSD"
            id="gama.shapefile.support.type"
            name="Shapefile support"
            priority="high">
         <property
               name="gama.support.target">
         </property>
      </content-type>
      <content-type
            base-type="org.eclipse.core.runtime.text"
            default-charset="UTF-8"
            file-extensions="CSV,csv,TSV,tsv"
            id="gama.csv.file.type"
            name="CSV"
            priority="high">
      </content-type>
      <content-type
            base-type="org.eclipse.core.runtime.text"
            default-charset="UTF-8"
            file-extensions="gaml,experiment"
            id="gama.gaml.file.type"
            name="GAML"
            priority="high">
      </content-type>
      <content-type
            base-type="org.eclipse.core.runtime.text"
            file-extensions="html,HTML,htm,HTM,svg,SVG"
            id="gama.html.file.type"
            name="HTML (in GAMA)"
            priority="normal">
      </content-type>
      <content-type
            default-charset="UTF-8"
            file-extensions="json,JSON,geojson,GEOJSON"
            id="gama.json.file.type"
            name="JSON File"
            priority="high">
      </content-type>
      <content-type
            default-charset="UTF-8"
            describer="gama.workspace.metadata.GMLContentDescriber"
            file-extensions="gml,GML"
            id="gama.gml.file.type"
            name="GML File"
            priority="high">
      </content-type>
   </extension>
</plugin>
